---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath, langPrefix, CONTACT_EMAIL } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  path={getLocalizedPath(lang, '/contact/')}
  title={`${t('contact.title')} · SimpleTime`}
  description={t('meta.contact.description')}
>
  <PageHeader title={t('contact.title')} subtitle={t('contact.subtitle')} />

  <section class="mx-auto max-w-3xl px-5 pb-28 pt-6 sm:px-8">
    <div class="rise delay-2 contact-card">
      <h2 class="t-label">{t('contact.email.label')}</h2>
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="contact-mail font-display mt-6 inline-flex items-center gap-3 break-all text-[26px] font-semibold tracking-[-0.03em] text-ink sm:text-[40px]"
      >
        {CONTACT_EMAIL}
        <svg class="h-[0.6em] w-[0.6em] shrink-0 rtl:-scale-x-100" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"></path>
        </svg>
      </a>
      <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-muted text-pretty">{t('contact.email.body')}</p>
      <p class="mt-8 border-t border-line pt-6 text-[15px] leading-relaxed text-muted">{t('contact.response')}</p>
    </div>

    <p class="mt-10 text-[16px] text-muted">
      {t('contact.faq')}
      {' '}
      <a href={`${langPrefix(lang)}/faq/`} class="link-more">{t('contact.faq.link')}</a>
    </p>
  </section>
</Layout>

<style>
  .contact-card {
    border-radius: 1.75rem;
    background: var(--surface);
    padding: 2rem;
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -40px rgb(12 20 38 / 0.35);
  }

  @media (min-width: 640px) {
    .contact-card {
      padding: 3rem;
    }
  }

  .contact-mail {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.3s ease;
  }

  .contact-mail:hover {
    text-decoration-color: currentColor;
  }

  .contact-mail svg {
    transition: transform 0.4s var(--ease-out-expo);
  }

  .contact-mail:hover svg {
    transform: translateX(0.12em);
  }
</style>
