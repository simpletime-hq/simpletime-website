---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { phoneScreen } from '../i18n/screens';
import { DAY, totals, taskName, duration } from '../i18n/day';
import AppStoreButton from './AppStoreButton.astro';
import DeviceFrame from './DeviceFrame.astro';
import LiveActivity from './LiveActivity.astro';
import DayRibbon from './DayRibbon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { home, store, shots } = getContent(lang);
const hero = home.hero;
const legend = totals(DAY);
const total = legend.reduce((sum, item) => sum + item.minutes, 0);

// Chinese and Japanese run sentences together; everywhere else they are spaced.
const sentenceGap = lang === 'ja' || lang === 'zh' ? '' : ' ';
---

<section class="hero sky-dawn relative overflow-x-clip">
  <div class="wrap relative grid items-center gap-x-10 gap-y-12 pt-10 pb-12 sm:pt-16 lg:grid-cols-12 lg:pt-14 lg:pb-16">
    <div class="relative z-10 lg:col-span-8">
      <h1 class="t-hero rise">
        <span class="block">{hero.titleLead}</span>
        <span class="block">{hero.titleAccent}</span>
      </h1>

      {/* The first two paragraphs of the App Store description, word for word. */}
      <p class="rise delay-1 t-intro mt-7 max-w-[35rem] text-muted">
        {`${store.lead}${sentenceGap}${store.promise}`}
      </p>

      <div class="rise delay-2 mt-9 flex flex-wrap items-center gap-x-8 gap-y-5">
        <AppStoreButton label={t('appstore.download')} size="lg" />
        <a href="#features" class="link-more text-[17px]">
          {hero.cta}
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"></path>
          </svg>
        </a>
      </div>

      <ul class="rise delay-3 hero-proof mt-10 flex flex-wrap gap-x-3 gap-y-1.5 text-[15px] text-muted">
        {hero.proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="relative lg:col-span-4">
      <div class="hero-stage">
        <DeviceFrame
          image={phoneScreen(lang, 'tracking')}
          alt={shots[0].alt}
          loading="eager"
          sizes="(min-width: 1024px) 330px, 62vw"
          class="hero-phone rise-media delay-1"
        />
        <div class="hero-live rise-media delay-4">
          <LiveActivity lang={lang} />
        </div>
      </div>
    </div>
  </div>

  {/* Today, as the app would draw it: every block a task, the open one still running. */}
  <div class="wrap pb-20 sm:pb-28">
    <div class="flex items-baseline justify-between gap-6 border-t border-line pt-6">
      <p class="t-label">{t('day.today')}</p>
      <p class="t-clock text-[1.375rem] text-ink" dir="ltr">{duration(total)}</p>
    </div>
    <DayRibbon id="rh" blocks={DAY} variant="hero" scale class="mt-5" />
    <ul class="mt-7 flex flex-wrap gap-x-8 gap-y-3">
      {
        legend.map((item) => (
          <li class="flex items-center gap-2.5 text-[14px]">
            <span class:list={['legend-dot', `bg-${item.task}`]} aria-hidden="true" />
            <span class="text-ink-2">{taskName(lang, item.task)}</span>
            <span class="tabular text-muted" dir="ltr">{duration(item.minutes)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The dot belongs to the item before it, so a wrapped line never starts with one. */
  .hero-proof li {
    white-space: nowrap;
  }

  .hero-proof li:not(:last-child)::after {
    content: '·';
    margin-inline-start: 0.75rem;
    color: var(--subtle);
  }

  .hero-stage {
    position: relative;
    margin-inline: auto;
    width: min(62vw, 20.5rem);
  }

  @media (min-width: 1024px) {
    .hero-stage {
      width: min(100%, 20.75rem);
      margin-inline-end: 0;
    }
  }

  /* The Lock Screen card, floating in front of the phone – the same task and
     time the screen shows. */
  .hero-live {
    position: absolute;
    z-index: 2;
    top: 63%;
    inset-inline-start: 50%;
    translate: -50% 0;
    font-size: clamp(0.8rem, 2.7vw, 0.95rem);
  }

  :global([dir='rtl']) .hero-live {
    translate: 50% 0;
  }

  .hero-live :global(.live-card) {
    --tint: #5e5ce6;
  }

  .hero-live :global(.live-card__timer) {
    color: #9b99ff;
  }

  @media (min-width: 1024px) {
    .hero-live {
      font-size: 0.8rem;
    }
  }

  .legend-dot {
    width: 0.625rem;
    height: 0.625rem;
    flex: none;
    border-radius: 0.2rem;
  }
</style>
