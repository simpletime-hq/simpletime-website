---
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';
import RichText from './RichText.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, CONTACT_EMAIL } from '../i18n/utils';

/**
 * A text with legal weight – privacy policy, terms of use, accessibility
 * statement: its date, the note that the German version applies, the short
 * summary, a table of contents and the sections.
 */
interface Section {
  id: string;
  title: string;
  paragraphs?: string[];
  address?: boolean;
  subsections?: { title: string; paragraphs: string[] }[];
}

interface Props {
  lang: Lang;
  doc: {
    title: string;
    updated: string;
    translationNote?: string;
    summaryTitle: string;
    summary: string[];
    sections: Section[];
  };
  path: string;
  description: string;
  /** Bump when the content changes – the date is part of the text. */
  lastUpdated: string;
}

const { lang, doc, path, description, lastUpdated } = Astro.props;
const t = useTranslations(lang);

const DATE_LOCALE: Record<Lang, string> = {
  en: 'en-US', de: 'de-DE', nl: 'nl-NL', sv: 'sv-SE', fr: 'fr-FR', it: 'it-IT', es: 'es-ES',
  pt: 'pt-PT', ru: 'ru-RU', uk: 'uk-UA', el: 'el-GR', tr: 'tr-TR', hy: 'hy-AM', ar: 'ar',
  he: 'he-IL', hi: 'hi-IN', zh: 'zh-CN', ja: 'ja-JP',
};
const formatted = new Date(lastUpdated).toLocaleDateString(DATE_LOCALE[lang], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout lang={lang} path={path} title={`${doc.title} · SimpleTime`} description={description}>
  <PageHeader title={doc.title} />

  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="text-sm text-subtle">{doc.updated}: {formatted}</p>

    {
      lang !== 'de' && doc.translationNote && (
        <p class="mt-3 text-sm text-subtle">
          <RichText text={doc.translationNote} lang={lang} />
        </p>
      )
    }

    <div class="mt-8 rounded-[1.75rem] bg-canvas-alt p-7 sm:p-9 dark:bg-surface">
      <h2 class="text-lg font-semibold text-ink">{doc.summaryTitle}</h2>
      <ul class="mt-4 space-y-3">
        {
          doc.summary.map((point) => (
            <li class="flex gap-3 leading-relaxed text-muted">
              <svg
                class="mt-1 h-4 w-4 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4.5 12.5l4.5 4.5L19.5 6.5" />
              </svg>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="mt-8" aria-label={doc.title}>
      <ol class="flex flex-wrap gap-x-5 gap-y-2 text-[15px]">
        {
          doc.sections.map((section) => (
            <li>
              <a href={`#${section.id}`} class="text-accent hover:underline">
                {section.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      doc.sections.map((section) => (
        <section id={section.id} class="scroll-mt-24">
          <h2 class="mt-12 text-xl font-semibold text-ink">{section.title}</h2>
          {section.paragraphs?.map((paragraph) => (
            <p class="mt-3 leading-relaxed text-muted">
              <RichText text={paragraph} lang={lang} />
            </p>
          ))}
          {section.address && (
            <p class="mt-3 leading-relaxed text-muted">
              Luca Efinger
              <br />
              Friedrich-Ebert-Ring 16
              <br />
              97072 Würzburg
              <br />
              {t('imprint.country')}
              <br />
              <a href={`mailto:${CONTACT_EMAIL}`} class="text-accent hover:underline">
                {CONTACT_EMAIL}
              </a>
            </p>
          )}
          {section.subsections?.map((sub) => (
            <>
              <h3 class="mt-7 text-lg font-semibold text-ink">{sub.title}</h3>
              {sub.paragraphs.map((paragraph) => (
                <p class="mt-3 leading-relaxed text-muted">
                  <RichText text={paragraph} lang={lang} />
                </p>
              ))}
            </>
          ))}
        </section>
      ))
    }
  </article>
</Layout>
