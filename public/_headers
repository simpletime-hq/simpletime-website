/*
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://intern.atriya.io; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://intern.atriya.io; upgrade-insecure-requests

# Astro fingerprints these filenames, so they can never change in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names — cache for a week, but let them be replaced.
