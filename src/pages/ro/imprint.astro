---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { useTranslations, CONTACT_EMAIL } from '../../i18n/utils';

// The legal notice is a legal text: this language shows the English one, under a
// heading and a note in its own language (src/i18n/legal.ts).
const lang = 'ro';
const t = useTranslations(lang);
const en = useTranslations('en');
---

<Layout lang={lang} path="/ro/imprint/" title={`${t('footer.imprint')} · SimpleTime`} description={t('meta.imprint.description')}>
  <PageHeader title={t('footer.imprint')} />

  {/* Left to right also on fa, ur and ps pages; the note keeps the page's direction. */}
  <article class="mx-auto max-w-3xl px-5 sm:px-8 py-16 sm:py-20" lang="en" dir="ltr">
    <p class="mb-8 rounded-2xl bg-canvas-alt px-5 py-4 text-[15px] leading-relaxed text-muted dark:bg-surface" lang={lang} dir="auto">{t('legal.englishOnly')}</p>

    <h2 class="text-xl font-semibold text-ink mt-0">{en('imprint.according')}</h2>
    <p class="mt-3 text-muted leading-relaxed">
      Luca Efinger<br />
      Friedrich-Ebert-Ring 16<br />
      97072 Würzburg<br />
      {en('imprint.country')}
    </p>

    <h2 class="text-xl font-semibold text-ink mt-10">{en('imprint.contact')}</h2>
    <p class="mt-3 text-muted">
      {en('contact.email.label')}: <a href={`mailto:${CONTACT_EMAIL}`} class="text-accent hover:underline">{CONTACT_EMAIL}</a>
    </p>

    <h2 class="text-xl font-semibold text-ink mt-10">{en('imprint.responsible')}</h2>
    <p class="mt-3 text-muted leading-relaxed">
      Luca Efinger<br />
      Friedrich-Ebert-Ring 16<br />
      97072 Würzburg<br />
      {en('imprint.country')}
    </p>

    <h2 class="text-2xl font-bold text-ink mt-14">{en('imprint.disclaimer.title')}</h2>

    <h3 class="text-lg font-semibold text-ink mt-8">{en('imprint.disclaimer.liability.title')}</h3>
    <p class="mt-3 text-muted leading-relaxed">{en('imprint.disclaimer.liability.body')}</p>

    <h3 class="text-lg font-semibold text-ink mt-8">{en('imprint.disclaimer.links.title')}</h3>
    <p class="mt-3 text-muted leading-relaxed">{en('imprint.disclaimer.links.body')}</p>

    <h3 class="text-lg font-semibold text-ink mt-8">{en('imprint.disclaimer.copyright.title')}</h3>
    <p class="mt-3 text-muted leading-relaxed">{en('imprint.disclaimer.copyright.body')}</p>
  </article>
</Layout>
