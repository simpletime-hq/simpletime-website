---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { phoneScreen, type PhoneScreen } from '../i18n/screens';
import { clock, isoTime } from '../i18n/day';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, shots } = getContent(lang);
const alt = (id: string) => shots.find((s) => s.id === id)?.alt ?? '';

// Three moments of the day: lunch, the end of the working day, the evening
// report. The screen is the one the App Store shows for each.
const at = (h: number, m: number) => h * 60 + m;
const moments: Record<string, { minutes: number; screen: PhoneScreen }> = {
  day: { minutes: at(12, 30), screen: 'timeline' },
  insights: { minutes: at(17, 45), screen: 'chart' },
  reports: { minutes: at(19, 30), screen: 'report' },
};

const chapters = home.showcase.map((item) => {
  const moment = moments[item.id];
  return {
    ...item,
    time: clock(lang, moment.minutes),
    iso: isoTime(moment.minutes),
    image: phoneScreen(lang, moment.screen),
    alt: alt(moment.screen),
  };
});
---

{/*
  One phone stays while the day goes by: on a wide screen it is pinned beside
  the text and changes its screen – and the clock above it its time – as each
  chapter reaches the middle of the window. Narrow screens show each chapter
  with its own phone instead.
*/}
<section id="features" class="story sky-day relative scroll-mt-16">
  <div class="wrap">
    <div class="story-grid">
      <div class="story-chapters">
        {
          chapters.map((c, i) => (
            <article class="chapter" data-chapter={i}>
              <div class="chapter-copy reveal">
                {/* The stage's clock, for narrow screens that have no stage. */}
                <p class="t-clock mb-5 text-[2.75rem] text-ink sm:text-[3.5rem] lg:hidden" aria-hidden="true" dir="ltr">
                  {c.time}
                </p>
                <p class="t-label">
                  <time datetime={c.iso} dir="ltr">{c.time}</time>
                  <span class="chapter-sep" aria-hidden="true" />
                  {c.eyebrow}
                </p>
                <h2 class="t-section mt-6">{c.title}</h2>
                <p class="t-intro mt-7 max-w-[34rem] text-muted">{c.body}</p>
                <ul class="chapter-points mt-10 max-w-[30rem]">
                  {c.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
              <div class="chapter-phone reveal-media lg:hidden">
                <DeviceFrame image={c.image} alt={c.alt} sizes="(min-width: 640px) 300px, 64vw" />
              </div>
            </article>
          ))
        }
      </div>

      <div class="story-stage" data-stage>
        <div class="stage-inner">
          <div class="stage-clock t-clock" aria-hidden="true" dir="ltr">
            {
              chapters.map((c, i) => (
                <span class:list={['stage-clock__face', i === 0 && 'is-active']}>{c.time}</span>
              ))
            }
          </div>
          <div class="iphone stage-phone">
            <span class="iphone__key iphone__key--action" aria-hidden="true"></span>
            <span class="iphone__key iphone__key--up" aria-hidden="true"></span>
            <span class="iphone__key iphone__key--down" aria-hidden="true"></span>
            <span class="iphone__key iphone__key--side" aria-hidden="true"></span>
            <span class="iphone__key iphone__key--camera" aria-hidden="true"></span>
            <div class="iphone__body">
              <div class="iphone__glass">
                <div class="iphone__screen">
                  {
                    chapters.map((c, i) => (
                      <Image
                        src={c.image}
                        alt={c.alt}
                        widths={[300, 400, 600, 800]}
                        sizes="(min-width: 1280px) 360px, 30vw"
                        loading="lazy"
                        decoding="async"
                        class:list={['stage-screen', i === 0 && 'is-active']}
                      />
                    ))
                  }
                  <span class="iphone__island" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: clamp(4rem, 8vw, 7rem) clamp(5rem, 10vw, 9rem);
  }

  .story-grid {
    display: grid;
    gap: 0;
  }

  .chapter {
    display: grid;
    gap: 3.5rem;
    padding-block: 3.5rem;
  }

  .chapter + .chapter {
    border-top: 1px solid var(--line);
  }

  .chapter-sep {
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    margin-inline: 0.75rem;
    vertical-align: middle;
    background: var(--line-strong);
  }

  .chapter-points li {
    padding-block: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .chapter-points li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .chapter-phone {
    width: min(64vw, 18.75rem);
    margin-inline: auto;
  }

  .story-stage {
    display: none;
  }

  @media (min-width: 1024px) {
    .story-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: 4rem;
    }

    /* Each chapter holds the stage for most of a screen's height. */
    .chapter {
      min-height: 92vh;
      align-content: center;
      padding-block: 10vh;
    }

    .chapter + .chapter {
      border-top: 0;
    }

    .story-stage {
      display: block;
    }

    .stage-inner {
      position: sticky;
      top: calc(56px + 5vh);
      height: calc(100vh - 56px - 10vh);
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      justify-items: center;
      gap: 1.5rem;
    }

    .stage-phone {
      /* As tall as the window allows, never wider than the column. */
      width: min(100%, calc((100vh - 56px - 10vh - 6.5rem) / 2.172));
      align-self: start;
    }
  }

  /* The clock: one face per chapter, stacked; the current one in front. */
  .stage-clock {
    position: relative;
    display: grid;
    font-size: clamp(3rem, 1rem + 3.2vw, 4.75rem);
    color: var(--ink);
  }

  .stage-clock__face {
    grid-area: 1 / 1;
    justify-self: center;
    opacity: 0;
    transform: translateY(0.45em);
    transition:
      opacity 0.5s var(--ease-out-soft),
      transform 0.8s var(--ease-out-expo);
  }

  .stage-clock__face.is-active {
    opacity: 1;
    transform: none;
  }

  .stage-clock__face.is-past {
    transform: translateY(-0.45em);
  }

  .stage-phone :global(.stage-screen) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.6s var(--ease-out-soft),
      transform 0.9s var(--ease-out-expo);
  }

  .stage-phone :global(.stage-screen.is-active) {
    opacity: 1;
    transform: none;
  }

  /* The first screen holds the frame's height; the others lie on top. */
  .stage-phone :global(.stage-screen:first-child) {
    position: relative;
  }
</style>

<script>
  // The chapter whose middle is closest to the middle of the window drives the
  // stage. A thin band across the centre does the measuring – no scroll handler.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const chapters = [...document.querySelectorAll<HTMLElement>('.chapter[data-chapter]')];

  if (stage && chapters.length && 'IntersectionObserver' in window) {
    const faces = [...stage.querySelectorAll<HTMLElement>('.stage-clock__face')];
    const screens = [...stage.querySelectorAll<HTMLElement>('.stage-screen')];
    let current = 0;

    const show = (index: number) => {
      if (index === current) return;
      current = index;
      faces.forEach((face, i) => {
        face.classList.toggle('is-active', i === index);
        face.classList.toggle('is-past', i < index);
      });
      screens.forEach((screen, i) => screen.classList.toggle('is-active', i === index));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) show(Number((entry.target as HTMLElement).dataset.chapter));
        }
      },
      { rootMargin: '-48% 0px -48% 0px' },
    );
    chapters.forEach((chapter) => observer.observe(chapter));

    // The other screens load once the stage is close, not with the page.
    const preload = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        screens.forEach((img) => img.setAttribute('loading', 'eager'));
        preload.disconnect();
      },
      { rootMargin: '600px 0px' },
    );
    preload.observe(stage);
  }
</script>
