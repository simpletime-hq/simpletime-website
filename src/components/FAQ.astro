---
import type { Lang } from '../i18n/ui';
import { langPrefix, useTranslations } from '../i18n/utils';
import { getContent, faqById, HOME_FAQ } from '../i18n/content';
import FaqEntry from './FaqEntry.astro';

interface Props {
  lang: Lang;
}

// The six questions people ask before downloading. The full list is on /faq/;
// `#faq` stays here because the app links to it (Website.faq).
const { lang } = Astro.props;
const t = useTranslations(lang);
const { faq } = getContent(lang).home;
const entries = faqById(lang);
const items = HOME_FAQ.map((id) => entries.get(id)).filter((item) => item !== undefined);
---

<section id="faq" class="sec faq scroll-mt-14">
  <div class="wrap">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="sec-head lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
        <p class="eyebrow reveal">{t('nav.faq')}</p>
        <h2 class="reveal delay-1 t-section mt-6">{faq.title}</h2>
        <p class="reveal delay-2 t-intro mt-6 text-muted">{faq.subtitle}</p>
        <a href={`${langPrefix(lang)}/faq/`} class="reveal delay-3 link-more mt-8 text-[17px]">
          {faq.button}
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"></path>
          </svg>
        </a>
      </div>

      <div class="reveal delay-1 faq-list divide-y divide-line-strong border-y border-line-strong lg:col-span-7">
        {items.map((item) => <FaqEntry lang={lang} item={item} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--canvas);
  }
</style>
