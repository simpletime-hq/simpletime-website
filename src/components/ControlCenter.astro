---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

// A corner of Control Center with SimpleTime's control switched on – the
// client project running – among a few of the system's own, and Siri's glow
// below: the two ways to start and stop without opening the app.
const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['cc', className]} aria-hidden="true">
  <div class="cc__panel">
    <div class="cc__grid">
      <span class="cc__control cc__control--on">
        <svg viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="7" width="10" height="10" rx="2.2"></rect></svg>
      </span>
      <span class="cc__control">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.5a1 1 0 0 1 1 1v.6a6.9 6.9 0 0 1 0 13.8v.6a1 1 0 1 1-2 0v-.6a6.9 6.9 0 0 1 0-13.8v-.6a1 1 0 0 1 1-1zm0 3.6a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8z"></path></svg>
      </span>
      <span class="cc__control">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.6 3.3a.8.8 0 0 1 .2 1A7.6 7.6 0 0 0 19.7 15a.8.8 0 0 1 .9 1.1A9 9 0 1 1 13.6 3.1a.8.8 0 0 1 1 .2z"></path></svg>
      </span>
      <span class="cc__control">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4c3.3 0 6.3 1.3 8.5 3.4a.9.9 0 0 1-1.2 1.3A10.5 10.5 0 0 0 12 5.8c-2.8 0-5.4 1.1-7.3 2.9a.9.9 0 1 1-1.2-1.3A12.3 12.3 0 0 1 12 4zm0 4.6c2.1 0 4 .8 5.4 2.2a.9.9 0 1 1-1.3 1.2 5.8 5.8 0 0 0-8.2 0 .9.9 0 1 1-1.3-1.2A7.6 7.6 0 0 1 12 8.6zm0 4.6c1 0 1.9.4 2.5 1a.9.9 0 0 1 0 1.3L12.6 17.4a.9.9 0 0 1-1.2 0l-1.9-1.9a.9.9 0 0 1 0-1.3c.6-.6 1.5-1 2.5-1z"></path></svg>
      </span>
    </div>
    <p class="cc__caption">{t('live.task')}</p>
  </div>
  <div class="cc__siri"><span></span></div>
</div>

<style>
  .cc {
    container-type: inline-size;
    position: relative;
    width: 100%;
  }

  .cc__panel {
    padding: 7cqw;
    border-radius: 12cqw;
    background:
      radial-gradient(110% 90% at 0% 0%, rgb(94 92 230 / 0.55), transparent 60%),
      radial-gradient(90% 90% at 100% 100%, rgb(48 176 199 / 0.45), transparent 60%),
      #1a1d2b;
    box-shadow: inset 0 0 0 0.4cqw rgb(255 255 255 / 0.08);
  }

  .cc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 5cqw;
    justify-items: center;
  }

  .cc__control {
    display: grid;
    place-items: center;
    width: 30cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    color: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
  }

  .cc__control svg {
    width: 44%;
    height: 44%;
  }

  /* SimpleTime's control, on: white with the task colour, as iOS draws an active control. */
  .cc__control--on {
    background: #ffffff;
    color: #5856d6;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.5);
    animation: cc-pulse 3.2s ease-out infinite;
  }

  @keyframes cc-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0.45);
    }
    70%,
    100% {
      box-shadow: 0 0 0 7cqw rgb(255 255 255 / 0);
    }
  }

  .cc__caption {
    margin-top: 4cqw;
    padding-inline-start: 2cqw;
    font-size: 6.2cqw;
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  /* Siri: the glow at the edge of the screen while it listens. */
  .cc__siri {
    position: absolute;
    inset-inline-end: -5cqw;
    bottom: -6cqw;
    width: 30cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #ff5fa2, #ffb340, #5ee0ff, #6f6bff, #ff5fa2);
    filter: blur(0.3cqw);
    box-shadow: 0 0 9cqw rgb(111 107 255 / 0.55);
    animation: cc-spin 9s linear infinite;
  }

  .cc__siri span {
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #ffffff 0%, #d9e4ff 35%, #9db4ff 100%);
    opacity: 0.9;
  }

  @keyframes cc-spin {
    to {
      rotate: 1turn;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc__control--on,
    .cc__siri {
      animation: none;
    }
  }
</style>
