---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

// The medium widget with the running task: the client project from the
// screenshots, its clock counting on, and the stop button.
const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);
const ELAPSED = 42 * 60 + 5;
---

<div class:list={['widget-m', className]} aria-hidden="true" data-live data-elapsed={ELAPSED}>
  <div class="widget-m__face">
    <div class="widget-m__task">
      <span class="widget-m__icon">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M5.5 5h13A1.5 1.5 0 0 1 20 6.5v8.75a.75.75 0 0 1-.75.75H4.75a.75.75 0 0 1-.75-.75V6.5A1.5 1.5 0 0 1 5.5 5zm.5 2v7h12V7H6zM2.6 17.5h18.8c.33 0 .6.27.6.6 0 .77-.63 1.4-1.4 1.4H3.4c-.77 0-1.4-.63-1.4-1.4 0-.33.27-.6.6-.6z"></path>
        </svg>
      </span>
      <span class="widget-m__name">{t('live.task')}</span>
    </div>
    <div class="widget-m__row">
      <span class="widget-m__timer" dir="ltr" data-live-timer>0:42:05</span>
      <span class="widget-m__stop">
        <svg viewBox="0 0 12 12" fill="currentColor"><rect x="2" y="2" width="8" height="8" rx="1.8"></rect></svg>
        {t('live.stop')}
      </span>
    </div>
  </div>
</div>

<script>
  import '../scripts/live-timer';
</script>

<style>
  .widget-m {
    container-type: inline-size;
    width: 100%;
  }

  .widget-m__face {
    aspect-ratio: 2.12;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5.2cqw 5.6cqw;
    border-radius: 11cqw;
    background: #ffffff;
    color: #0b0b0d;
    box-shadow:
      0 0 0 1px rgb(12 20 38 / 0.05),
      0 1.5cqw 4.5cqw -1cqw rgb(12 20 38 / 0.22);
  }

  :global(.dark) .widget-m__face,
  :global(.night) .widget-m__face {
    background: #1c1c1e;
    color: #ffffff;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .widget-m__task {
    display: flex;
    align-items: center;
    gap: 2.4cqw;
    min-width: 0;
  }

  .widget-m__icon {
    display: grid;
    place-items: center;
    width: 8.4cqw;
    height: 8.4cqw;
    flex: none;
    border-radius: 2.4cqw;
    background: #5856d6;
    color: #fff;
  }

  .widget-m__icon svg {
    width: 5.4cqw;
    height: 5.4cqw;
  }

  .widget-m__name {
    overflow: hidden;
    font-size: 5.4cqw;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .widget-m__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3cqw;
  }

  .widget-m__timer {
    font-family: var(--font-rounded);
    font-size: 11cqw;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #5856d6;
  }

  :global(.dark) .widget-m__timer,
  :global(.night) .widget-m__timer {
    color: #9b99ff;
  }

  .widget-m__stop {
    display: inline-flex;
    align-items: center;
    gap: 1.4cqw;
    flex: none;
    border-radius: 999px;
    padding: 1.8cqw 3.6cqw;
    font-size: 4.2cqw;
    font-weight: 650;
    /* iOS red, a shade deeper so the white label reads (5.5 : 1). */
    background: #d70015;
    color: #fff;
  }

  .widget-m__stop svg {
    width: 3.2cqw;
    height: 3.2cqw;
  }
</style>
