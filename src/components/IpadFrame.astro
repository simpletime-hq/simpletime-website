---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

// An iPad Pro upright. Drawn in src/styles/devices.css, in cqw like the iPhone.
const { image, alt, sizes = '(min-width: 1024px) 260px, 40vw', loading = 'lazy', class: className = '' } = Astro.props;
---

<div class:list={['ipad', className]}>
  <div class="ipad__body">
    <span class="ipad__camera" aria-hidden="true"></span>
    <div class="ipad__screen">
      <Image src={image} alt={alt} widths={[260, 400, 600, 1032]} sizes={sizes} loading={loading} decoding="async" />
    </div>
  </div>
</div>
