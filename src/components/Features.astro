---
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, store } = getContent(lang);
---

{/*
  Every section of the App Store description with its points word for word –
  the list and the App Store say exactly the same, and all of it is free.
  Set like a spec sheet: the section on one side, its points on the other.
*/}
<section id="free" class="sky-evening scroll-mt-16">
  <div class="wrap py-24 sm:py-32">
    <header class="max-w-[46rem]">
      <h2 class="t-section reveal">{home.features.title}</h2>
      <p class="t-intro reveal delay-1 mt-6 text-muted">{home.features.subtitle}</p>
    </header>

    <div class="mt-16 sm:mt-20">
      {
        store.sections.map((section) => (
          <article class="spec reveal">
            <h3 class="spec__title">{section.title}</h3>
            <ul class="spec__points">
              {section.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .spec {
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem 2.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .spec:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .spec__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 620;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  :global(:is(:lang(ar), :lang(he), :lang(hi), :lang(ja), :lang(zh), :lang(hy))) .spec__title {
    letter-spacing: 0;
    font-weight: 700;
  }

  .spec__points {
    display: grid;
    gap: 0.85rem 2.5rem;
  }

  .spec__points li {
    position: relative;
    padding-inline-start: 1.4rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* A short time block instead of a bullet. */
  .spec__points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 0.7rem;
    height: 0.3rem;
    border-radius: 0.15rem;
    background: var(--line-strong);
  }

  @media (min-width: 768px) {
    .spec {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 2.5rem;
      padding-block: 2.5rem 2.75rem;
    }

    .spec__points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
