---
import { Image } from 'astro:assets';
import ProFeatures from './ProFeatures.astro';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { langPrefix } from '../i18n/utils';
import { getContent } from '../i18n/content';

interface Props {
  lang: Lang;
}

// SimpleTime Pro on the home page: what it adds, each part drawn the way the
// app shows it, in the copy of the Pro page – and how to get it.
const { lang } = Astro.props;
const { home, store, pro } = getContent(lang);

const markFile = import.meta.glob<{ default: ImageMetadata }>('../assets/pro/mark.webp', { eager: true });
const mark = Object.values(markFile)[0].default;
---

<section id="pro" class="sec pro night">
  <div class="wrap">
    <header class="sec-head">
      <p class="pro-kicker reveal">
        <Image src={mark} alt="" width={32} height={32} widths={[32, 64]} sizes="32px" class="pro-kicker__mark" />
        <span>{store.pro.title}</span>
      </p>
      <h2 class="t-section reveal delay-1 mt-6">{pro.title}</h2>
      <p class="t-intro reveal delay-2 mt-6 text-muted">{store.pro.intro}</p>
    </header>

    <div class="mt-14 lg:mt-20">
      <ProFeatures lang={lang} />
    </div>

    <div class="mt-16 flex flex-col gap-8 border-t border-line pt-12 lg:flex-row lg:items-center lg:justify-between">
      <p class="reveal max-w-[40rem] text-[15px] leading-relaxed text-muted text-pretty">{store.pro.pricing}</p>
      <a href={`${langPrefix(lang)}/pro/`} class="btn btn--primary reveal delay-1 shrink-0 self-start lg:self-auto">
        {home.pro.button}
        <svg class="h-3 w-3 rtl:-scale-x-100" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
<style>
  .pro {
    background:
      radial-gradient(70rem 40rem at 80% -10%, rgb(88 86 214 / 0.28), transparent 70%),
      var(--canvas);
  }

  .pro-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 640;
    color: var(--ink);
  }

  .pro-kicker :global(.pro-kicker__mark) {
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
  }
</style>
