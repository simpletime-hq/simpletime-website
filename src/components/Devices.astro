---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { ipadScreen, macScreen } from '../i18n/screens';
import MacFrame from './MacFrame.astro';
import IpadFrame from './IpadFrame.astro';
import WatchFrame from './WatchFrame.astro';
import WatchFace from './WatchFace.astro';
import HomeScreen from './HomeScreen.astro';
import LockScreen from './LockScreen.astro';
import ControlCenter from './ControlCenter.astro';

interface Props {
  lang: Lang;
}

// Where SimpleTime runs and where its clock shows: the two device parts of the
// App Store description, word for word, each beside what it describes.
const { lang } = Astro.props;
const t = useTranslations(lang);
const { home, store, shots, pro } = getContent(lang);

const points = (id: string) => {
  const section = store.sections.find((s) => s.id === id);
  if (!section) throw new Error(`Devices: section "${id}" is missing in ${lang}`);
  return section.points;
};
const [widgets, lockScreen, control, siri] = points('widgets');
const [sync, languageCount, access] = points('devices');
const watch = pro.features.find((f) => f.id === 'watch');
const alt = (id: string) => shots.find((s) => s.id === id)?.alt ?? '';
// The language picker of the app: each language in its own words, under it
// its name in the visitor's language, the visitor's own one ticked first.
const endonym = (code: string) => {
  const name = new Intl.DisplayNames([code], { type: 'language' }).of(code) ?? code;
  return name.charAt(0).toLocaleUpperCase(code) + name.slice(1);
};
const local = new Intl.DisplayNames([lang], { type: 'language' });
const pickerCodes = [lang, ...['en', 'fr', 'ja', 'ar'].filter((c) => c !== lang)].slice(0, 4);
const picker = pickerCodes.map((code) => ({
  code,
  endonym: endonym(code),
  local: local.of(code) ?? code,
  current: code === lang,
}));
---

<section id="devices" class="sec devices">
  <div class="wrap">
    <header class="sec-head">
      <p class="eyebrow reveal">{t('nav.devices')}</p>
      <h2 class="t-section reveal delay-1 mt-6">{home.devices.title}</h2>
      <p class="t-intro reveal delay-2 mt-6 text-muted">{home.devices.subtitle}</p>
    </header>

    <div class="bento mt-14 lg:mt-20">
      <article class="tile bento-mac reveal">
        <div class="bento-text">
          <p class="bento-kicker" dir="ltr">Mac · iPad</p>
          <p class="bento-lead">{sync}</p>
        </div>
        <div class="bento-mac__stage">
          <div class="bento-mac__mac">
            <MacFrame image={macScreen(lang, 'chart')} alt={alt('chart')} />
          </div>
          <div class="bento-mac__ipad">
            <IpadFrame image={ipadScreen(lang, 'timeline')} alt={alt('timeline')} sizes="(min-width: 1024px) 200px, 34vw" />
          </div>
        </div>
      </article>

      <article class="tile bento-watch reveal delay-1">
        <div class="bento-text">
          <p class="bento-kicker"><span dir="ltr">Apple Watch</span><span class="chip">Pro</span></p>
          {watch && <p class="bento-lead">{watch.body}</p>}
        </div>
        <div class="bento-watch__stage">
          <WatchFrame>
            <WatchFace lang={lang} />
          </WatchFrame>
        </div>
      </article>

      <article class="tile bento-widgets reveal">
        <div class="bento-widgets__stage">
          <HomeScreen lang={lang} />
        </div>
        <p class="bento-lead bento-foot">{widgets}</p>
      </article>

      <article class="tile bento-lock reveal delay-1">
        <div class="bento-lock__stage">
          <LockScreen lang={lang} />
        </div>
        <p class="bento-lead bento-foot">{lockScreen}</p>
      </article>

      <article class="tile bento-control reveal delay-2">
        <div class="bento-control__stage">
          <ControlCenter lang={lang} />
        </div>
        <div class="bento-foot">
          <p class="bento-lead">{control}</p>
          <p class="tile-body mt-3">{siri}</p>
        </div>
      </article>

      <article class="tile bento-fact reveal">
        <div class="fact-visual" aria-hidden="true">
          <ul class="picker">
            {
              picker.map((row) => (
                <li class:list={['picker__row', row.current && 'is-current']}>
                  <span class="picker__names">
                    <span class="picker__name" lang={row.code}>{row.endonym}</span>
                    {!row.current && <span class="picker__local">{row.local}</span>}
                  </span>
                  {row.current && (
                    <svg class="picker__check" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2.5 7.4l3 3L11.5 4" />
                    </svg>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
        <p class="bento-lead">{languageCount}</p>
      </article>

      <article class="tile bento-fact reveal delay-1">
        <div class="fact-visual" aria-hidden="true">
          <div class="a11y">
            <span class="a11y__row">
              <span class="a11y__play">
                <svg viewBox="0 0 12 12" fill="currentColor"><path d="M3.6 2.2v7.6a.6.6 0 0 0 .9.5l6-3.8a.6.6 0 0 0 0-1L4.5 1.7a.6.6 0 0 0-.9.5z" /></svg>
              </span>
              <span class="a11y__name">{t('live.task')}</span>
            </span>
            <span class="a11y__slider">
              <span class="a11y__a">A</span>
              <span class="a11y__track"><i /></span>
              <span class="a11y__a a11y__a--big">A</span>
            </span>
          </div>
        </div>
        <p class="bento-lead">{access}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .devices {
    background: var(--canvas-alt);
  }

  .bento {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-mac {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .bento-mac {
      grid-column: span 4;
    }

    .bento-watch,
    .bento-widgets,
    .bento-lock,
    .bento-control {
      grid-column: span 2;
    }

    .bento-fact {
      grid-column: span 3;
    }
  }

  .bento .tile {
    display: flex;
    flex-direction: column;
  }

  .bento-text {
    padding: 1.75rem 1.75rem 0;
  }

  /* Under a picture the sentence sits at the foot of the tile, so the tiles of
     a row line up whatever the length of their text. */
  .bento-foot {
    margin-top: auto;
    padding: 0 1.75rem 1.75rem;
  }

  @media (min-width: 1024px) {
    .bento-text {
      padding: 2.25rem 2.25rem 0;
    }

    .bento-foot {
      padding: 0 2.25rem 2.25rem;
    }
  }

  .bento-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 620;
    color: var(--subtle);
  }

  .bento-lead {
    margin-top: 0.6rem;
    font-size: 1.1875rem;
    font-weight: 560;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: pretty;
  }

  :is(:lang(ar), :lang(he), :lang(hi), :lang(ja), :lang(zh), :lang(hy)) .bento-lead {
    letter-spacing: 0;
  }

  /* Mac and iPad: the Mac fills the tile, the iPad stands in front of it. */
  .bento-mac__stage {
    position: relative;
    margin-top: auto;
    padding: 2.5rem 1.5rem 0;
  }

  .bento-mac__mac {
    width: 88%;
    margin-inline: auto 0;
    translate: 3% 0;
  }

  :global([dir='rtl']) .bento-mac__mac {
    translate: -3% 0;
  }

  .bento-mac__ipad {
    position: absolute;
    bottom: 1.5rem;
    inset-inline-start: 4%;
    width: 27%;
  }

  @media (min-width: 1024px) {
    .bento-mac__stage {
      padding: 3rem 2.25rem 2.25rem;
    }

    .bento-mac__ipad {
      bottom: 2.25rem;
    }
  }

  .bento-watch__stage {
    display: grid;
    place-items: center;
    flex: 1;
    padding: 2.5rem 1.75rem 2.25rem;
  }

  .bento-watch__stage > :global(*) {
    width: min(58%, 13rem);
  }

  /* Two widgets as they sit on a Home Screen, on a wallpaper of the task colours. */
  .bento-widgets__stage,
  .bento-lock__stage,
  .bento-control__stage {
    position: relative;
    margin: 1rem 1rem 1.75rem;
    border-radius: 1.25rem;
  }

  .bento-widgets__stage,
  .bento-lock__stage,
  .bento-control__stage {
    flex: 1;
  }

  /* A wallpaper of soft light, the widgets on it as on a Home Screen. */
  .bento-widgets__stage {
    display: grid;
    align-content: center;
    padding: 1.6rem 1.4rem;
    background:
      radial-gradient(80% 70% at 15% 10%, rgb(129 140 248 / 0.75), transparent 70%),
      radial-gradient(70% 70% at 90% 30%, rgb(192 132 252 / 0.6), transparent 70%),
      radial-gradient(90% 80% at 60% 100%, rgb(251 146 60 / 0.55), transparent 70%),
      #c7c9f5;
  }

  :global(.dark) .bento-widgets__stage {
    background:
      radial-gradient(80% 70% at 15% 10%, rgb(67 56 202 / 0.85), transparent 70%),
      radial-gradient(70% 70% at 90% 30%, rgb(126 34 206 / 0.6), transparent 70%),
      radial-gradient(90% 80% at 60% 100%, rgb(194 65 12 / 0.5), transparent 70%),
      #1e1b4b;
  }

  .bento-lock__stage {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
    background: var(--surface-2);
  }

  .bento-lock__stage > :global(*) {
    width: min(100%, 18rem);
  }

  .bento-control__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.75rem 1.5rem 2.25rem;
    background: var(--surface-2);
  }

  .bento-control__stage > :global(*) {
    width: min(88%, 16.5rem);
  }

  /* Two facts, each beside a piece of the app: the language picker and a task
     row in large type under VoiceOver's frame. */
  .bento-fact {
    padding: 1.75rem;
  }

  @media (min-width: 1024px) {
    .bento .bento-fact {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 2.25rem 1.75rem 1.75rem;
    }

    .bento-fact .bento-lead {
      margin-top: 0;
    }
  }

  .fact-visual {
    margin-bottom: 1.25rem;
    padding: 1rem;
    border-radius: 1.1rem;
    background: var(--surface-2);
  }

  @media (min-width: 1024px) {
    .fact-visual {
      margin-bottom: 0;
    }
  }

  .picker {
    overflow: hidden;
    border-radius: 0.8rem;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }

  .picker__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0.8rem;
  }

  .picker__row + .picker__row {
    border-top: 1px solid var(--line);
  }

  .picker__names {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .picker__name {
    font-size: 0.8125rem;
    font-weight: 560;
    line-height: 1.3;
    color: var(--ink);
  }

  .picker__local {
    font-size: 0.6875rem;
    line-height: 1.25;
    color: var(--muted);
  }

  .picker__check {
    flex-shrink: 0;
    width: 0.85rem;
    height: 0.85rem;
    color: var(--accent);
  }

  .a11y {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* A task row in large type, VoiceOver's frame around it. */
  .a11y__row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.8rem;
    background: var(--surface);
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .a11y__play {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #5e5ce6;
    color: #fff;
  }

  .a11y__play svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  /* Large type wraps, as the app's rows do – it is not cut short. */
  .a11y__name {
    display: -webkit-box;
    min-width: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.01em;
    hyphens: auto;
    overflow-wrap: anywhere;
    color: var(--ink);
  }

  /* The text-size slider of iOS: a small A, the track, a large A. */
  .a11y__slider {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-inline: 0.2rem;
    color: var(--muted);
  }

  .a11y__a {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
  }

  .a11y__a--big {
    font-size: 1.25rem;
  }

  .a11y__track {
    position: relative;
    flex: 1;
    height: 0.28rem;
    border-radius: 999px;
    background: var(--line-strong);
  }

  .a11y__track i {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 72%;
    border-radius: inherit;
    background: var(--accent);
  }

  .a11y__track i::after {
    content: '';
    position: absolute;
    top: 50%;
    inset-inline-end: -0.6rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.04),
      0 2px 6px rgb(0 0 0 / 0.22);
    translate: 0 -50%;
  }
</style>
