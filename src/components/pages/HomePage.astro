---
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import FeatureTour from '../FeatureTour.astro';
import Devices from '../Devices.astro';
import PrivacyBand from '../PrivacyBand.astro';
import Audience from '../Audience.astro';
import ProSection from '../ProSection.astro';
import FAQ from '../FAQ.astro';
import CTA from '../CTA.astro';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{/*
  The questions a visitor has, in the order they come: what it is, what it
  does, where it runs, what happens to the data, who it is for, what Pro adds –
  then the remaining questions and the download.
*/}
<Layout lang={lang} path={getLocalizedPath(lang, '/')}>
  <Hero lang={lang} />
  <FeatureTour lang={lang} />
  <Devices lang={lang} />
  <PrivacyBand lang={lang} />
  <Audience lang={lang} />
  <ProSection lang={lang} />
  <FAQ lang={lang} />
  <CTA lang={lang} />
</Layout>
