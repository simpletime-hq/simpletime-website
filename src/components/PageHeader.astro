---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

{/*
  The top of every inner page: the home page's light ground with its glow,
  and the title on the same edge as the text below it – that column is 48rem
  wide on every inner page.
*/}
<section class="page-header ground-glow">
  <div class="mx-auto max-w-3xl px-5 pb-10 pt-16 sm:px-8 sm:pb-14 sm:pt-24">
    <h1 class="page-title rise t-section">{title}</h1>
    {
      subtitle && (
        <p class="rise delay-1 t-intro mt-6 max-w-2xl text-muted">
          {subtitle}
        </p>
      )
    }
  </div>
</section>

<style>
  /* Long compounds – „Datenschutzerklärung“ – are hyphenated in the page's
     language rather than broken anywhere inside the word. */
  .page-title {
    hyphens: auto;
    -webkit-hyphens: auto;
  }
</style>
