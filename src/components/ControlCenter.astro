---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

// Control Center with SimpleTime's control among the system's own – drawn
// after SimpleTimeWidgets/TrackingControlWidget.swift: a toggle tinted blue,
// on while a task runs, the symbol stop.circle.fill and the running task's
// name as its label. Around it the controls everyone knows, so the eye finds
// the one that is SimpleTime's.
const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['cc', className]} aria-hidden="true">
  <div class="cc__grid">
    {/* Connectivity: airplane mode off, mobile data, Wi-Fi and Bluetooth on. */}
    <div class="cc__module">
      <span class="cc__dot">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 15.5v-1.9l-7.6-4.8V4.2a1.4 1.4 0 0 0-2.8 0v4.6L3 13.6v1.9l7.6-2.4v4.6l-2 1.5V21l3.4-1 3.4 1v-1.8l-2-1.5v-4.6z"></path></svg>
      </span>
      <span class="cc__dot cc__dot--green">
        <svg viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="14" width="3" height="5" rx="1"></rect><rect x="9" y="11" width="3" height="8" rx="1"></rect><rect x="14" y="8" width="3" height="11" rx="1"></rect><rect x="19" y="5" width="3" height="14" rx="1" opacity=".35"></rect></svg>
      </span>
      <span class="cc__dot cc__dot--blue">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 5c3.2 0 6.1 1.2 8.3 3.3a1 1 0 0 1-1.4 1.4A9.9 9.9 0 0 0 12 7a9.9 9.9 0 0 0-6.9 2.7 1 1 0 0 1-1.4-1.4A11.9 11.9 0 0 1 12 5zm0 4.4c2 0 3.8.8 5.1 2.1a1 1 0 0 1-1.4 1.4 5.3 5.3 0 0 0-7.4 0 1 1 0 0 1-1.4-1.4A7.2 7.2 0 0 1 12 9.4zm0 4.4c.9 0 1.7.3 2.3.9a.8.8 0 0 1 0 1.2l-1.7 1.7a.8.8 0 0 1-1.2 0l-1.7-1.7a.8.8 0 0 1 0-1.2c.6-.6 1.4-.9 2.3-.9z"></path></svg>
      </span>
      <span class="cc__dot cc__dot--blue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 8.2 16 15.8 12 19.5V4.5l4 3.7-8.5 7.6"></path></svg>
      </span>
    </div>

    {/* SimpleTime's control, 2 × 2: on, blue, the running task as its label. */}
    <span class="cc__large">
      <span class="cc__dot cc__dot--blue">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.2" fill="currentColor"></circle><rect x="8.6" y="8.6" width="6.8" height="6.8" rx="1.4" fill="#0a84ff"></rect></svg>
      </span>
      <span class="cc__label">{t('live.task')}</span>
    </span>

    {/* Focus, rotation lock, torch and timer, as 1 × 1 controls. */}
    <span class="cc__control">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.6 3.3a.8.8 0 0 1 .2 1A7.6 7.6 0 0 0 19.7 15a.8.8 0 0 1 .9 1.1A9 9 0 1 1 13.6 3.1a.8.8 0 0 1 1 .2z"></path></svg>
    </span>
    <span class="cc__control">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12a7 7 0 1 1-2.1-5"></path><path d="M17.5 3.8v3.4h-3.4"></path><rect x="9.3" y="11" width="5.4" height="4.2" rx="1"></rect><path d="M10.4 11V9.9a1.6 1.6 0 0 1 3.2 0V11"></path></svg>
    </span>
    <span class="cc__control">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 2.5h8a1 1 0 0 1 1 1V6l-2.2 4v10a1.5 1.5 0 0 1-1.5 1.5h-2.6A1.5 1.5 0 0 1 9.2 20V10L7 6V3.5a1 1 0 0 1 1-1zm4 10a1 1 0 0 0-1 1v1.5a1 1 0 0 0 2 0v-1.5a1 1 0 0 0-1-1z"></path></svg>
    </span>
    <span class="cc__control">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="13" r="7.5"></circle><path d="M12 13V9.2M10 2.8h4"></path></svg>
    </span>

  </div>
</div>

<style>
  .cc {
    container-type: inline-size;
    width: 100%;
  }

  /* Four columns, as Control Center lays out its controls. */
  .cc__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4.2cqw;
    padding: 6cqw;
    border-radius: 12cqw;
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(94 92 230 / 0.45), transparent 60%),
      radial-gradient(90% 90% at 100% 100%, rgb(48 176 199 / 0.32), transparent 60%),
      rgb(28 30 44 / 0.92);
    box-shadow:
      inset 0 0 0 0.35cqw rgb(255 255 255 / 0.1),
      0 6cqw 14cqw -6cqw rgb(8 14 34 / 0.6);
    color: #fff;
  }

  .cc__module {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-column: span 2;
    grid-row: span 2;
    place-items: center;
    gap: 3cqw;
    padding: 3.4cqw;
    border-radius: 9cqw;
    background: rgb(255 255 255 / 0.12);
  }

  .cc__dot,
  .cc__control {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    color: rgb(255 255 255 / 0.95);
  }

  .cc__dot {
    width: 15cqw;
  }

  .cc__dot--blue {
    background: #0a84ff;
  }

  .cc__dot--green {
    background: #30d158;
  }

  .cc__dot svg {
    width: 52%;
    height: 52%;
  }

  .cc__control svg {
    width: 46%;
    height: 46%;
  }

  /* The large size: the symbol at the top, the name below it. */
  .cc__large {
    display: flex;
    grid-column: span 2;
    grid-row: span 2;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: 4cqw;
    border-radius: 9cqw;
    background: rgb(255 255 255 / 0.16);
  }

  .cc__large .cc__dot svg {
    width: 64%;
    height: 64%;
  }

  .cc__label {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 4.4cqw;
    font-weight: 600;
    line-height: 1.18;
    overflow-wrap: anywhere;
  }
</style>
