---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { useTranslations, CONTACT_EMAIL } from '../../i18n/utils';

const lang = 'ja';
const t = useTranslations(lang);
import '../../styles/fonts-ja.css';
---

<Layout lang={lang} path="/ja/imprint/" title={`${t('imprint.title')} · SimpleTime`} description={t('meta.imprint.description')}>
  <PageHeader title={t('imprint.title')} />

  <article class="mx-auto max-w-3xl px-5 sm:px-8 py-16 sm:py-20 prose prose-slate">
    <h2 class="text-xl font-semibold text-ink mt-0">{t('imprint.according')}</h2>
    <p class="mt-3 text-muted leading-relaxed not-italic">
      Luca Efinger<br />
      Friedrich-Ebert-Ring 16<br />
      97072 Würzburg<br />
      {t('imprint.country')}
    </p>

    <h2 class="text-xl font-semibold text-ink mt-10">{t('imprint.contact')}</h2>
    <p class="mt-3 text-muted">
      Email: <a href={`mailto:${CONTACT_EMAIL}`} class="text-accent hover:underline">{CONTACT_EMAIL}</a>
    </p>

    <h2 class="text-xl font-semibold text-ink mt-10">{t('imprint.responsible')}</h2>
    <p class="mt-3 text-muted leading-relaxed">
      Luca Efinger<br />
      Friedrich-Ebert-Ring 16<br />
      97072 Würzburg<br />
      {t('imprint.country')}
    </p>

    <h2 class="text-2xl font-bold text-ink mt-14">{t('imprint.disclaimer.title')}</h2>

    <h3 class="text-lg font-semibold text-ink mt-8">{t('imprint.disclaimer.liability.title')}</h3>
    <p class="mt-3 text-muted leading-relaxed">{t('imprint.disclaimer.liability.body')}</p>

    <h3 class="text-lg font-semibold text-ink mt-8">{t('imprint.disclaimer.links.title')}</h3>
    <p class="mt-3 text-muted leading-relaxed">{t('imprint.disclaimer.links.body')}</p>

    <h3 class="text-lg font-semibold text-ink mt-8">{t('imprint.disclaimer.copyright.title')}</h3>
    <p class="mt-3 text-muted leading-relaxed">{t('imprint.disclaimer.copyright.body')}</p>
  </article>
</Layout>
