---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { langPrefix } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { watchScreen } from '../i18n/screens';
import { clock, isoTime } from '../i18n/day';
import WatchFrame from './WatchFrame.astro';

interface Props {
  lang: Lang;
}

// The Pro part of the App Store description, as it stands there – at night,
// when the day is done: the Apple Watch it brings, in front of a year in light.
const { lang } = Astro.props;
const { home, store } = getContent(lang);
const pro = store.pro;
const night = 22 * 60;

// The eight colourways of the app icon, each with the Pro star – in the app's order.
const iconFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/pro/icon-*.webp', { eager: true });
const icons = ['standard', 'petrol', 'violet', 'slate', 'forest', 'burgundy', 'graphite', 'espresso'].map(
  (name) => iconFiles[`../assets/pro/icon-${name}.webp`].default,
);

// A year of days, the way the year overview draws it: 53 weeks of seven,
// brighter the more was tracked. Weekdays carry more than weekends, and a
// fixed pseudo-random hash does the rest, so every build draws the same year.
const CELL = 14;
const GAP = 4;
const days: { x: number; y: number; level: number }[] = [];
for (let week = 0; week < 53; week++) {
  for (let day = 0; day < 7; day++) {
    const hash = Math.abs(Math.sin(week * 12.9898 + day * 78.233) * 43758.5453) % 1;
    const weekend = day >= 5;
    const value = hash * (weekend ? 0.55 : 1) + (week > 8 && week < 20 ? 0.18 : 0);
    days.push({ x: week * (CELL + GAP), y: day * (CELL + GAP), level: Math.min(4, Math.floor(value * 5)) });
  }
}
const width = 53 * (CELL + GAP) - GAP;
const height = 7 * (CELL + GAP) - GAP;
---

<section id="pro" class="pro-night night scroll-mt-14">
  <div class="pro-horizon" aria-hidden="true"></div>

  <div class="wrap relative pb-24 pt-8 sm:pb-32">
    <div class="grid items-center gap-x-12 gap-y-14 lg:grid-cols-12">
      <header class="lg:col-span-5">
        <p class="t-label reveal">
          <time datetime={isoTime(night)} dir="ltr">{clock(lang, night)}</time>
        </p>
        <h2 class="t-section reveal delay-1 mt-6">{pro.title}</h2>
        <p class="t-intro reveal delay-2 mt-6 max-w-[30rem] text-muted">{pro.intro}</p>
      </header>

      <div class="pro-stage reveal-media delay-2 lg:col-span-7" aria-hidden="true">
        <svg class="pro-year" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid meet">
          {days.map((d) => <rect x={d.x} y={d.y} width={CELL} height={CELL} rx="3.5" class={`lv${d.level}`} />)}
        </svg>
        <WatchFrame image={watchScreen(lang, 'running')} alt="" class="pro-watch" sizes="240px" />
      </div>
    </div>

    <ul class="pro-points mt-16 sm:mt-24">
      {
        pro.points.map((point, i) => (
          <li class:list={['reveal', `delay-${(i % 3) + 1}`]}>
            <svg class="pro-points__star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.5l2.4 6.1 6.1 2.4-6.1 2.4-2.4 6.1-2.4-6.1L3.5 11l6.1-2.4z" />
            </svg>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 flex flex-col gap-10 border-t border-line pt-12 lg:flex-row lg:items-center lg:justify-between">
      <div class="reveal flex flex-wrap gap-3" aria-hidden="true">
        {
          icons.map((icon) => (
            <Image
              src={icon}
              alt=""
              width={52}
              height={52}
              widths={[52, 104]}
              sizes="52px"
              class="pro-icon h-11 w-11 rounded-[22.5%] sm:h-[3.25rem] sm:w-[3.25rem]"
            />
          ))
        }
      </div>
      <div class="reveal delay-1 max-w-[34rem]">
        <p class="text-[15px] leading-relaxed text-muted text-pretty">{pro.pricing}</p>
        <a href={`${langPrefix(lang)}/pro/`} class="btn btn--primary mt-7">
          {home.pro.button}
          <svg class="h-3 w-3 rtl:-scale-x-100" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pro-night {
    position: relative;
    isolation: isolate;
  }

  /* Dusk turns into night: the band starts in the colour the section above
     ends in. `--dusk` is the page's, not the night's – .night leaves it alone. */
  .pro-horizon {
    height: clamp(9rem, 18vw, 15rem);
    background: linear-gradient(
      180deg,
      var(--dusk) 0%,
      color-mix(in srgb, var(--dusk) 55%, #1b2560) 34%,
      #121a46 62%,
      var(--canvas) 100%
    );
  }

  .pro-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(19rem, 38vw, 27rem);
  }

  .pro-year {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: radial-gradient(70% 90% at 50% 50%, #000 35%, transparent 100%);
  }

  .pro-year .lv0 {
    fill: #141d45;
  }

  .pro-year .lv1 {
    fill: #1d2f72;
  }

  .pro-year .lv2 {
    fill: #2a4bb6;
  }

  .pro-year .lv3 {
    fill: #4677ff;
  }

  .pro-year .lv4 {
    fill: #9ab9ff;
  }

  /* The year sweeps in from the first week to the last. */
  :global(.js) .pro-stage .pro-year {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.8s var(--ease-out-expo) 0.25s;
  }

  :global(.js [dir='rtl']) .pro-stage .pro-year {
    clip-path: inset(0 0 0 100%);
  }

  :global(.js) .pro-stage:global(.is-visible) .pro-year {
    clip-path: inset(0 0 0 0);
  }

  .pro-stage :global(.pro-watch) {
    position: relative;
    z-index: 1;
    width: clamp(10rem, 20vw, 14rem);
  }

  .pro-points {
    display: grid;
    gap: 1.75rem 3rem;
  }

  @media (min-width: 640px) {
    .pro-points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .pro-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pro-points li {
    display: flex;
    gap: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .pro-points__star {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    margin-top: 0.2em;
    color: #9db4ff;
  }

  .pro-night :global(.pro-icon) {
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 12px 24px -12px rgb(0 0 0 / 0.8);
  }
</style>
