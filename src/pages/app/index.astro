const ENTRY_EN =
  'This calendar event was recorded with SimpleTime. On an iPhone, iPad or Mac with SimpleTime, the link opens the entry.';
---

<Layout
  lang="en"
  path="/app/"
  title="Open in SimpleTime"
  description="This link opens a page in SimpleTime on an iPhone, iPad or Mac where SimpleTime is installed."
  noIndex
  analytics={false}
  noReferrer
>
  <section class="ground-glow relative overflow-hidden">
    <div class="mx-auto max-w-3xl px-5 py-28 text-center sm:px-8 sm:py-36">
      <img src="/logo.png" alt="" width="96" height="96" class="mx-auto h-24 w-24 rounded-[22%] shadow-lift" />

      <h1 id="app-title" class="t-title mt-8">Open in SimpleTime</h1>

      <p id="app-body" class="t-intro mx-auto mt-5 max-w-md text-muted" data-entry={ENTRY_EN}>
        This link opens a page in SimpleTime – on an iPhone, iPad or Mac where SimpleTime is installed.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <span id="app-store">
          <AppStoreButton label="Download SimpleTime on the App Store" size="lg" />
        </span>
        <a id="app-home" href="/" class="btn btn--quiet">
          <span id="app-home-label">About SimpleTime</span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ COPY }}>
    (function () {
      // A calendar event links to its entry – say so instead of the general sentence.
      var istEintrag = /^\/app\/entry\//.test(window.location.pathname);
      var body = document.getElementById('app-body');
      if (istEintrag) body.textContent = body.getAttribute('data-entry');

      // Safari's banner hands the address to the app when it opens it. Only a plain
      // /app/… path goes along: the banner reads comma-separated pairs, and a crafted
      // address could otherwise slip in a different app-id.
      var pfad = window.location.pathname;
      var banner = document.querySelector('meta[name="apple-itunes-app"]');
      if (banner && /^\/app\/[A-Za-z0-9\/-]*$/.test(pfad)) {
        banner.setAttribute('content', 'app-id=6755532037, app-argument=https://simple-time.app' + pfad);
      }

      var sprachen = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
      var code = null;
      for (var i = 0; i < sprachen.length && !code; i++) {
        var kurz = String(sprachen[i]).toLowerCase().split('-')[0];
        if (COPY[kurz]) code = kurz;
        if (kurz === 'en') break;
      }
      if (!code) return;
      var copy = COPY[code];

      document.documentElement.lang = code;
      if (code === 'ar' || code === 'he') document.documentElement.dir = 'rtl';
      document.title = copy.title;
      document.getElementById('app-title').textContent = copy.title;
      body.textContent = istEintrag ? copy.entry : copy.body;
      document.querySelector('#app-store a').setAttribute('aria-label', copy.store);
      document.getElementById('app-home').setAttribute('href', '/' + code + '/');
      document.getElementById('app-home-label').textContent = copy.home;
    })();
  </script>
</Layout>
