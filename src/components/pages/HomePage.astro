---
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import Story from '../Story.astro';
import Features from '../Features.astro';
import Audience from '../Audience.astro';
import ProBand from '../ProBand.astro';
import FAQ from '../FAQ.astro';
import CTA from '../CTA.astro';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{/*
  One day, top to bottom: the morning above the fold, the app through the day,
  dusk for the people it is made for – and Pro, the questions and the close at
  night.
*/}
<Layout lang={lang} path={getLocalizedPath(lang, '/')} dayProgress>
  <Hero lang={lang} />
  <Story lang={lang} />
  <Features lang={lang} />
  <Audience lang={lang} />
  <ProBand lang={lang} />
  <FAQ lang={lang} />
  <CTA lang={lang} />
</Layout>
