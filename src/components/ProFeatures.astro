---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';

interface Props {
  lang: Lang;
}

// What SimpleTime Pro adds, each part drawn the way the app shows it – the copy
// of the Pro page. Used on the home page and on /pro/, on a night ground.
const { lang } = Astro.props;
const { pro } = getContent(lang);
const feature = (id: string) => {
  const found = pro.features.find((f) => f.id === id);
  if (!found) throw new Error(`Pro section: feature "${id}" is missing in ${lang}`);
  return found;
};
const tiles = ['year', 'goals', 'reviews', 'places', 'focus', 'style', 'widget'].map(feature);
const more = ['watch', 'report', 'future'].map(feature);

const iconFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/pro/icon-*.webp', { eager: true });
const icons = ['standard', 'petrol', 'violet', 'slate', 'forest', 'burgundy', 'graphite', 'espresso'].map(
  (name) => iconFiles[`../assets/pro/icon-${name}.webp`].default,
);

// A year of days, the way the year overview draws it: 53 weeks of seven,
// brighter the more was tracked. Weekdays carry more than weekends, and a
// fixed pseudo-random hash does the rest, so every build draws the same year.
const CELL = 14;
const GAP = 4;
const days: { x: number; y: number; level: number }[] = [];
for (let week = 0; week < 53; week++) {
  for (let day = 0; day < 7; day++) {
    const hash = Math.abs(Math.sin(week * 12.9898 + day * 78.233) * 43758.5453) % 1;
    const weekend = day >= 5;
    const value = hash * (weekend ? 0.55 : 1) + (week > 8 && week < 20 ? 0.18 : 0);
    days.push({ x: week * (CELL + GAP), y: day * (CELL + GAP), level: Math.min(4, Math.floor(value * 5)) });
  }
}
const yearWidth = 53 * (CELL + GAP) - GAP;
const yearHeight = 7 * (CELL + GAP) - GAP;

// Goals as rings, the way the app shows a day's progress: the work goal
// nearly there, the reading goal half way, the training done.
const goals = [
  { task: 'work', r: 52, progress: 0.82 },
  { task: 'reading', r: 38, progress: 0.56 },
  { task: 'sport', r: 24, progress: 1 },
].map((g) => ({ ...g, length: 2 * Math.PI * g.r }));
const goalCss = goals
  .map(
    (g, i) =>
      `.goal-${i}{stroke-dasharray:${g.length.toFixed(2)};stroke-dashoffset:${(g.length * (1 - g.progress)).toFixed(2)};transition-delay:${200 + i * 160}ms}` +
      `.js .reveal:not(.is-visible) .goal-${i}{stroke-dashoffset:${g.length.toFixed(2)}}`,
  )
  .join('');

// A week of a review card: seven bars, the weekend lighter.
const week = [5.2, 6.8, 4.9, 7.4, 6.1, 2.2, 1.4];
const weekCss = week.map((h, i) => `.wb-${i}{height:${((h / 7.4) * 100).toFixed(1)}%;transition-delay:${150 + i * 60}ms}`).join('');

const accents = ['#173685', '#0f766e', '#6d28d9', '#475569', '#15803d', '#9f1239', '#3f3f46'];
---

<div class="pro-bento mt-14 lg:mt-20">
  {
    tiles.map((tile, i) => (
      <article class:list={['tile pro-tile reveal', `pro-tile--${tile.id}`, `delay-${(i % 3) + 1}`]}>
        <div class="pro-tile__visual" aria-hidden="true">
          {tile.id === 'year' && (
            <svg class="pro-year" viewBox={`0 0 ${yearWidth} ${yearHeight}`} preserveAspectRatio="xMidYMid meet">
              {days.map((d) => (
                <rect x={d.x} y={d.y} width={CELL} height={CELL} rx="3.5" class={`lv${d.level}`} />
              ))}
            </svg>
          )}
          {tile.id === 'goals' && (
            <svg class="pro-goals" viewBox="0 0 120 120">
              {goals.map((g, j) => (
                <g>
                  <circle cx="60" cy="60" r={g.r} class={`pro-goals__track stroke-${g.task}`} />
                  <circle cx="60" cy="60" r={g.r} transform="rotate(-90 60 60)" class={`pro-goals__ring stroke-${g.task} goal-${j}`} />
                </g>
              ))}
            </svg>
          )}
          {tile.id === 'reviews' && (
            <div class="pro-reviews">
              <span class="pro-reviews__card pro-reviews__card--back" />
              <span class="pro-reviews__card pro-reviews__card--mid" />
              <span class="pro-reviews__card pro-reviews__card--front">
                <span class="pro-reviews__total" dir="ltr">38:20</span>
                <span class="pro-reviews__bars">
                  {week.map((_, j) => (
                    <span class:list={['pro-reviews__bar', `wb-${j}`, j >= 5 && 'is-weekend']} />
                  ))}
                </span>
              </span>
            </div>
          )}
          {tile.id === 'places' && (
            <div class="pro-places">
              <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid slice">
                <path class="pro-places__road" d="M-10 84 C40 70 70 96 120 72 S190 40 215 46" />
                <path class="pro-places__road pro-places__road--minor" d="M58 -10 C64 30 52 70 66 130" />
                <path class="pro-places__road pro-places__road--minor" d="M142 -10 C136 40 150 80 140 130" />
                <circle class="pro-places__zone" cx="104" cy="58" r="30" />
              </svg>
              <span class="pro-places__pulse" />
              <span class="pro-places__pin">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M5.5 5h13A1.5 1.5 0 0 1 20 6.5v8.75a.75.75 0 0 1-.75.75H4.75a.75.75 0 0 1-.75-.75V6.5A1.5 1.5 0 0 1 5.5 5zm.5 2v7h12V7H6zM2.6 17.5h18.8c.33 0 .6.27.6.6 0 .77-.63 1.4-1.4 1.4H3.4c-.77 0-1.4-.63-1.4-1.4 0-.33.27-.6.6-.6z" />
                </svg>
              </span>
            </div>
          )}
          {tile.id === 'focus' && (
            <div class="pro-focus">
              <span class="pro-focus__pill">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 4.5h6A1.5 1.5 0 0 1 16.5 6v1.5h2A2.5 2.5 0 0 1 21 10v7.5A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5V10a2.5 2.5 0 0 1 2.5-2.5h2V6A1.5 1.5 0 0 1 9 4.5zm.5 3h5V6.5h-5z" />
                </svg>
              </span>
              <span class="pro-focus__rows">
                <span class="pro-focus__row bg-work" />
                <span class="pro-focus__row bg-client" />
                <span class="pro-focus__row is-hidden bg-sport" />
                <span class="pro-focus__row is-hidden bg-social" />
              </span>
            </div>
          )}
          {tile.id === 'style' && (
            <div class="pro-style">
              <span class="pro-style__icons">
                {icons.map((icon) => (
                  <Image src={icon} alt="" width={56} height={56} widths={[56, 112]} sizes="56px" class="pro-style__icon" />
                ))}
              </span>
              <span class="pro-style__accents">
                {accents.map((_, j) => (
                  <span class={`pro-style__dot ac-${j}`} />
                ))}
              </span>
            </div>
          )}
          {tile.id === 'widget' && (
            <span class="pro-quick">
              <span class="pro-quick__button bg-work" />
              <span class="pro-quick__button bg-study" />
              <span class="pro-quick__button bg-sport" />
              <span class="pro-quick__button bg-reading" />
            </span>
          )}
        </div>
        <div class="pro-tile__text">
          <h3 class="tile-title">{tile.title}</h3>
          <p class="tile-body mt-2">{tile.body}</p>
        </div>
      </article>
    ))
  }
</div>

<ul class="pro-more mt-4 grid gap-4 lg:mt-5 lg:grid-cols-3 lg:gap-5">
  {
    more.map((item, i) => (
      <li class:list={['pro-more__item reveal', `delay-${i + 1}`]}>
        <h3 class="tile-title">{item.title}</h3>
        <p class="tile-body mt-2">{item.body}</p>
      </li>
    ))
  }
</ul>
<style is:inline set:html={goalCss + weekCss + accents.map((c, i) => `.ac-${i}{background:${c}}`).join('')}></style>

<style>

  .pro-bento {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .pro-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pro-tile--year {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .pro-bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .pro-tile--year {
      grid-column: span 4;
    }

    .pro-tile--goals,
    .pro-tile--reviews,
    .pro-tile--places,
    .pro-tile--focus {
      grid-column: span 2;
    }

    .pro-tile--style,
    .pro-tile--widget {
      grid-column: span 3;
    }
  }

  .pro-tile {
    display: flex;
    flex-direction: column;
  }

  .pro-tile__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 11rem;
    margin: 1rem 1rem 0;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--surface-2);
    overflow: hidden;
  }

  .pro-tile__text {
    padding: 1.5rem 1.75rem 1.9rem;
  }

  /* The year: lit from the first week to the last as it comes into view. */
  .pro-year {
    width: 100%;
    height: auto;
    transition: clip-path 1.8s var(--ease-out-soft) 0.2s;
  }

  :global(.js) .reveal:not(.is-visible) .pro-year {
    clip-path: inset(0 100% 0 0);
  }

  :global([dir='rtl']) .reveal:not(.is-visible) .pro-year {
    clip-path: inset(0 0 0 100%);
  }

  .pro-year .lv0 { fill: var(--surface); }
  .pro-year .lv1 { fill: #1f3a8a; }
  .pro-year .lv2 { fill: #3457c8; }
  .pro-year .lv3 { fill: #5f82f0; }
  .pro-year .lv4 { fill: #a8c1ff; }

  .pro-goals {
    width: 8.5rem;
  }

  .pro-goals__track,
  .pro-goals__ring {
    fill: none;
    stroke-width: 11;
    stroke-linecap: round;
  }

  .pro-goals__track {
    opacity: 0.18;
  }

  .pro-goals__ring {
    transition: stroke-dashoffset 1.6s var(--ease-out-expo);
  }

  /* Reviews: a stack of cards, the week on top. */
  .pro-reviews {
    position: relative;
    width: 9.5rem;
    aspect-ratio: 0.78;
  }

  .pro-reviews__card {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }

  .pro-reviews__card--back {
    rotate: -9deg;
    translate: -14% 2%;
    background: linear-gradient(160deg, #ff9500, #ff2d55);
    opacity: 0.85;
  }

  .pro-reviews__card--mid {
    rotate: 6deg;
    translate: 12% 1%;
    background: linear-gradient(160deg, #34c759, #30b0c7);
    opacity: 0.9;
  }

  .pro-reviews__card--front {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    background: linear-gradient(160deg, #3d5fc0, #5856d6);
    color: #fff;
  }

  .pro-reviews__total {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 650;
    font-stretch: 120%;
    font-variant-numeric: tabular-nums;
  }

  .pro-reviews__bars {
    display: flex;
    align-items: flex-end;
    gap: 0.3rem;
    height: 3.5rem;
  }

  .pro-reviews__bar {
    flex: 1;
    border-radius: 0.2rem;
    background: rgb(255 255 255 / 0.92);
    transition: height 1s var(--ease-out-expo);
  }

  .pro-reviews__bar.is-weekend {
    background: rgb(255 255 255 / 0.5);
  }

  :global(.js) .reveal:not(.is-visible) .pro-reviews__bar {
    height: 6%;
  }

  /* Places: a few streets, the zone around the office, the task that starts there. */
  .pro-places {
    position: absolute;
    inset: 0;
  }

  .pro-places svg {
    width: 100%;
    height: 100%;
  }

  .pro-places__road {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 7;
    stroke-linecap: round;
  }

  .pro-places__road--minor {
    stroke-width: 4;
  }

  .pro-places__zone {
    fill: rgb(88 86 214 / 0.18);
    stroke: #8e8cf0;
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  .pro-places__pin,
  .pro-places__pulse {
    position: absolute;
    top: 48%;
    left: 52%;
    translate: -50% -50%;
    border-radius: 50%;
  }

  .pro-places__pin {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: #5856d6;
    color: #fff;
    box-shadow: 0 0 0 3px var(--surface-2);
  }

  .pro-places__pin svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .pro-places__pulse {
    width: 2.5rem;
    height: 2.5rem;
    background: rgb(142 140 240 / 0.5);
    animation: places-pulse 2.6s ease-out infinite;
  }

  @keyframes places-pulse {
    from {
      scale: 1;
      opacity: 0.8;
    }
    to {
      scale: 3.4;
      opacity: 0;
    }
  }

  /* Focus: work on, and the list keeps only the work. */
  .pro-focus {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .pro-focus__pill {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: #5856d6;
    color: #fff;
  }

  .pro-focus__pill svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .pro-focus__rows {
    display: grid;
    gap: 0.45rem;
    width: min(100%, 11rem);
  }

  .pro-focus__row {
    height: 0.9rem;
    border-radius: 999px;
    transition:
      opacity 0.8s ease 0.6s,
      scale 0.8s var(--ease-out-expo) 0.6s;
  }

  .pro-focus__row.is-hidden {
    opacity: 0.14;
  }

  :global(.js) .reveal:not(.is-visible) .pro-focus__row.is-hidden {
    opacity: 1;
  }

  .pro-style {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }

  .pro-style__icons {
    display: grid;
    grid-template-columns: repeat(4, 3.25rem);
    gap: 0.75rem;
  }

  @media (min-width: 1280px) {
    .pro-style__icons {
      grid-template-columns: repeat(8, 3.25rem);
    }
  }

  .pro-style :global(.pro-style__icon) {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 22.5%;
  }

  .pro-style__accents {
    display: flex;
    gap: 0.5rem;
  }

  .pro-style__dot {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
  }

  /* The quick start widget: four tasks, one tap each. */
  .pro-quick {
    display: grid;
    grid-template-columns: repeat(2, 3rem);
    gap: 0.7rem;
    padding: 1.1rem;
    border-radius: 1.6rem;
    background: #1c1c1e;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .pro-quick__button {
    position: relative;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
  }

  .pro-quick__button::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    translate: 12% 0;
    border-block: 0.5rem solid transparent;
    border-inline-start: 0.75rem solid #fff;
  }

  .pro-more__item {
    padding: 1.4rem 1.6rem;
    border-radius: 1.25rem;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  @media (prefers-reduced-motion: reduce) {
    .pro-places__pulse {
      animation: none;
      opacity: 0;
    }
  }
</style>
