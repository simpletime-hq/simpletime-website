---
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { AUDIENCE_DAYS } from '../i18n/day';
import DayRibbon from './DayRibbon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { audience } = getContent(lang).home;
---

{/* Four kinds of day, each drawn the way the app would draw it. */}
<section class="sky-dusk">
  <div class="wrap pb-28 pt-4 sm:pb-36">
    <header class="max-w-[46rem]">
      <h2 class="t-section reveal">{audience.title}</h2>
      <p class="t-intro reveal delay-1 mt-6 text-muted">{audience.subtitle}</p>
    </header>

    <div class="mt-14 grid gap-x-10 gap-y-12 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
      {
        audience.groups.map((group, i) => (
          <article class:list={['reveal', `delay-${(i % 4) + 1}`]}>
            <DayRibbon id={`ra${i}`} blocks={AUDIENCE_DAYS[group.id] ?? []} variant="mini" />
            <h3 class="mt-6 text-[1.25rem] font-semibold tracking-[-0.02em] text-ink">{group.title}</h3>
            <p class="mt-2.5 text-[1.0625rem] leading-relaxed text-muted text-pretty">{group.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
