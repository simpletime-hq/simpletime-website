---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { clock, taskName, type TaskKey } from '../i18n/day';
import { placeNotice } from '../i18n/places';
import logo from '../assets/brand/logo.png';

interface Props {
  lang: Lang;
  /** The home page: five tiles, two rows on a wide screen – all of Pro is on /pro/. */
  compact?: boolean;
}

// What SimpleTime Pro adds, each part drawn the way the app shows it – the copy
// of the Pro page. Used on the home page and on /pro/, on a night ground.
const { lang, compact = false } = Astro.props;
const { pro } = getContent(lang);
const feature = (id: string) => {
  const found = pro.features.find((f) => f.id === id);
  if (!found) throw new Error(`Pro section: feature "${id}" is missing in ${lang}`);
  return found;
};
const tiles = (compact
  ? ['year', 'goals', 'reviews', 'places', 'calendar']
  : ['year', 'goals', 'reviews', 'places', 'focus', 'style', 'widget', 'calendar']
).map(feature);
const more = compact ? [] : ['watch', 'report', 'future'].map(feature);

const iconFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/pro/icon-*.webp', { eager: true });
const icons = ['standard', 'petrol', 'violet', 'slate', 'forest', 'burgundy', 'graphite', 'espresso'].map(
  (name) => iconFiles[`../assets/pro/icon-${name}.webp`].default,
);

// A year of days, the way the year overview draws it: 53 weeks of seven,
// brighter the more was tracked. Weekdays carry more than weekends, and a
// fixed pseudo-random hash does the rest, so every build draws the same year.
const CELL = 14;
const GAP = 4;
const days: { x: number; y: number; level: number }[] = [];
for (let week = 0; week < 53; week++) {
  for (let day = 0; day < 7; day++) {
    const hash = Math.abs(Math.sin(week * 12.9898 + day * 78.233) * 43758.5453) % 1;
    const weekend = day >= 5;
    const value = hash * (weekend ? 0.55 : 1) + (week > 8 && week < 20 ? 0.18 : 0);
    days.push({ x: week * (CELL + GAP), y: day * (CELL + GAP), level: Math.min(4, Math.floor(value * 5)) });
  }
}
const yearWidth = 53 * (CELL + GAP) - GAP;
const yearHeight = 7 * (CELL + GAP) - GAP;

// Goals as rings, the way the app shows a day's progress: the work goal
// nearly there, the reading goal half way, the training done.
const goals = [
  { task: 'work', r: 52, progress: 0.82 },
  { task: 'reading', r: 38, progress: 0.56 },
  { task: 'sport', r: 24, progress: 1 },
].map((g) => ({ ...g, length: 2 * Math.PI * g.r }));
const goalCss = goals
  .map(
    (g, i) =>
      `.goal-${i}{stroke-dasharray:${g.length.toFixed(2)};stroke-dashoffset:${(g.length * (1 - g.progress)).toFixed(2)};transition-delay:${200 + i * 160}ms}` +
      `.js .reveal:not(.is-visible) .goal-${i}{stroke-dashoffset:${g.length.toFixed(2)}}`,
  )
  .join('');

// A week of a review card: seven bars, the weekend lighter.
const week = [5.2, 6.8, 4.9, 7.4, 6.1, 2.2, 1.4];
const weekCss = week.map((h, i) => `.wb-${i}{height:${((h / 7.4) * 100).toFixed(1)}%;transition-delay:${150 + i * 60}ms}`).join('');

const accents = ['#173685', '#0f766e', '#6d28d9', '#475569', '#15803d', '#9f1239', '#3f3f46'];

// A working week in the calendar: every entry an event, in the colour of its
// task – from the top of the day to the bottom, the way a week view draws it.
const calendar = [
  [['work', 0.06, 0.4], ['sport', 0.72, 0.88]],
  [['client', 0.14, 0.52], ['reading', 0.76, 0.92]],
  [['work', 0.04, 0.3], ['meetings', 0.38, 0.6]],
  [['client', 0.2, 0.46], ['work', 0.54, 0.8]],
  [['work', 0.1, 0.34], ['social', 0.62, 0.9]],
] as const;
let eventCount = 0;
const calendarDays = calendar.map((day) => day.map(([task, from, to]) => ({ task, from, to, n: eventCount++ })));
const calendarCss = calendarDays
  .flat()
  .map(
    (e) =>
      // Two classes: the scoped rule that sets the transition carries an attribute,
      // and a single class would lose its delay to it.
      `.cal__event.ce-${e.n}{top:${(e.from * 100).toFixed(1)}%;height:${((e.to - e.from) * 100).toFixed(1)}%;transition-delay:${200 + e.n * 70}ms}`,
  )
  .join('');

// The week of the sample day (Monday 31 August to Friday 4 September 2026),
// 8:00 to 20:00, headed as the Calendar app heads it: weekday and date.
const calendarHead = [0, 1, 2, 3, 4].map((i) => {
  const date = new Date(Date.UTC(2026, 7, 31 + i, 12));
  return {
    weekday: new Intl.DateTimeFormat(lang, { weekday: 'short', timeZone: 'UTC' }).format(date).replace(/\.$/, ''),
    day: new Intl.DateTimeFormat(lang, { day: 'numeric', timeZone: 'UTC', numberingSystem: 'latn' }).format(date),
  };
});
const twelveHours = new Intl.DateTimeFormat(lang, { hour: 'numeric' }).resolvedOptions().hourCycle?.startsWith('h1');
const calendarHours = [9, 12, 15, 18].map((h) =>
  new Intl.DateTimeFormat(lang, {
    hour: twelveHours ? 'numeric' : '2-digit',
    minute: twelveHours ? undefined : '2-digit',
    timeZone: 'UTC',
    numberingSystem: 'latn',
  }).format(new Date(Date.UTC(2026, 0, 7, h))),
);

// The quick-start widget (QuickStartWidget.swift): a list of tasks, each with
// its button – the running one with a stop and its name in bold.
const quickTasks: TaskKey[] = ['client', 'work', 'study', 'sport'];

// Focus on, and the list keeps the work: three tasks stay, the rest fades.
const focusKept: TaskKey[] = ['work', 'client', 'meetings'];
const focusHidden: TaskKey[] = ['sport', 'social'];

// Places: the notification the app sends on arrival, in its own words.
const arrival = placeNotice(lang, taskName(lang, 'work'), clock(lang, 8 * 60 + 2));
---

<div class:list={['pro-bento mt-14 lg:mt-20', compact && 'pro-bento--compact']}>
  {
    tiles.map((tile, i) => (
      <article class:list={['tile pro-tile reveal', `pro-tile--${tile.id}`, `delay-${(i % 3) + 1}`]}>
        <div class="pro-tile__visual" aria-hidden="true">
          {tile.id === 'year' && (
            <svg class="pro-year" viewBox={`0 0 ${yearWidth} ${yearHeight}`} preserveAspectRatio="xMidYMid meet">
              {days.map((d) => (
                <rect x={d.x} y={d.y} width={CELL} height={CELL} rx="3.5" class={`lv${d.level}`} />
              ))}
            </svg>
          )}
          {tile.id === 'goals' && (
            <svg class="pro-goals" viewBox="0 0 120 120">
              {goals.map((g, j) => (
                <g>
                  <circle cx="60" cy="60" r={g.r} class={`pro-goals__track stroke-${g.task}`} />
                  <circle cx="60" cy="60" r={g.r} transform="rotate(-90 60 60)" class={`pro-goals__ring stroke-${g.task} goal-${j}`} />
                </g>
              ))}
            </svg>
          )}
          {tile.id === 'reviews' && (
            <div class="pro-reviews">
              <span class="pro-reviews__card pro-reviews__card--back" />
              <span class="pro-reviews__card pro-reviews__card--mid" />
              <span class="pro-reviews__card pro-reviews__card--front">
                <span class="pro-reviews__total" dir="ltr">38:20</span>
                <span class="pro-reviews__bars">
                  {week.map((_, j) => (
                    <span class:list={['pro-reviews__bar', `wb-${j}`, j >= 5 && 'is-weekend']} />
                  ))}
                </span>
              </span>
            </div>
          )}
          {tile.id === 'places' && (
            <div class="places">
              <svg class="places__map" viewBox="0 0 240 150" preserveAspectRatio="xMidYMid slice">
                <rect class="places__park" x="150" y="86" width="96" height="70" rx="10" />
                <path class="places__water" d="M-10 128 C40 112 70 140 118 124 S170 150 250 138 V160 H-10z" />
                <g class="places__blocks">
                  <rect x="8" y="10" width="44" height="30" rx="5" /><rect x="62" y="10" width="54" height="30" rx="5" />
                  <rect x="8" y="50" width="44" height="34" rx="5" /><rect x="150" y="10" width="40" height="30" rx="5" />
                  <rect x="198" y="10" width="44" height="30" rx="5" /><rect x="198" y="48" width="44" height="30" rx="5" />
                  <rect x="62" y="92" width="54" height="22" rx="5" />
                </g>
                <path class="places__road" d="M-10 45 H250 M56 -10 V160 M120 -10 V160 M-10 88 H250 M194 -10 V82" />
              </svg>
              <span class="places__zone" />
              <span class="places__pin bg-work">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 4.5h6A1.5 1.5 0 0 1 16.5 6v1.5h2A2.5 2.5 0 0 1 21 10v7.5A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5V10a2.5 2.5 0 0 1 2.5-2.5h2V6A1.5 1.5 0 0 1 9 4.5zm.5 3h5V6.5h-5z" />
                </svg>
              </span>
              <span class="places__note">
                <Image src={logo} alt="" width={22} height={22} densities={[1, 2, 3]} class="places__icon" />
                <span class="places__text">
                  <span class="places__app">SimpleTime</span>
                  <span class="places__title">{arrival.title}</span>
                  <span class="places__body">{arrival.body}</span>
                </span>
              </span>
            </div>
          )}
          {tile.id === 'focus' && (
            <div class="focus">
              <span class="focus__pill">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 4.5h6A1.5 1.5 0 0 1 16.5 6v1.5h2A2.5 2.5 0 0 1 21 10v7.5A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5V10a2.5 2.5 0 0 1 2.5-2.5h2V6A1.5 1.5 0 0 1 9 4.5zm.5 3h5V6.5h-5z" />
                </svg>
                {taskName(lang, 'work')}
              </span>
              <span class="focus__list">
                {focusKept.map((task) => (
                  <span class="focus__row">
                    <span class={`focus__play bg-${task}`}>
                      <svg viewBox="0 0 12 12" fill="currentColor"><path d="M3.6 2.2v7.6a.6.6 0 0 0 .9.5l6-3.8a.6.6 0 0 0 0-1L4.5 1.7a.6.6 0 0 0-.9.5z" /></svg>
                    </span>
                    <span class="focus__name">{taskName(lang, task)}</span>
                  </span>
                ))}
                {focusHidden.map((task) => (
                  <span class="focus__row is-hidden">
                    <span class={`focus__play bg-${task}`} />
                    <span class="focus__ghost" />
                  </span>
                ))}
              </span>
            </div>
          )}
          {tile.id === 'style' && (
            <div class="pro-style">
              <span class="pro-style__icons">
                {icons.map((icon) => (
                  <Image src={icon} alt="" width={56} height={56} widths={[56, 112]} sizes="56px" class="pro-style__icon" />
                ))}
              </span>
              <span class="pro-style__accents">
                {accents.map((_, j) => (
                  <span class={`pro-style__dot ac-${j}`} />
                ))}
              </span>
            </div>
          )}
          {tile.id === 'widget' && (
            <span class="quick">
              {quickTasks.map((task, j) => (
                <span class:list={['quick__row', j === 0 && 'is-running']}>
                  <span class={`quick__button bg-${task}`}>
                    {j === 0 ? (
                      <svg viewBox="0 0 12 12" fill="currentColor"><rect x="3.2" y="3.2" width="5.6" height="5.6" rx="1.2" /></svg>
                    ) : (
                      <svg viewBox="0 0 12 12" fill="currentColor"><path d="M4 2.6v6.8a.55.55 0 0 0 .84.46l5.3-3.4a.55.55 0 0 0 0-.92l-5.3-3.4A.55.55 0 0 0 4 2.6z" /></svg>
                    )}
                  </span>
                  <span class="quick__name">{taskName(lang, task)}</span>
                </span>
              ))}
            </span>
          )}
          {tile.id === 'calendar' && (
            <div class="cal">
              <span class="cal__head">
                <span />
                {calendarHead.map((d) => (
                  <span class="cal__dayhead">
                    <span class="cal__weekday">{d.weekday}</span>
                    <span class="cal__date">{d.day}</span>
                  </span>
                ))}
              </span>
              <span class="cal__body">
                <span class="cal__hours">
                  {calendarHours.map((h) => (
                    <span>{h}</span>
                  ))}
                </span>
                {calendarDays.map((day) => (
                  <span class="cal__col">
                    {day.map((e) => (
                      <span class:list={['cal__event', `ev-${e.task}`, `ce-${e.n}`]}>
                        <span>{taskName(lang, e.task)}</span>
                      </span>
                    ))}
                  </span>
                ))}
              </span>
            </div>
          )}
        </div>
        <div class="pro-tile__text">
          <h3 class="tile-title">{tile.title}</h3>
          <p class="tile-body mt-2">{tile.body}</p>
        </div>
      </article>
    ))
  }
</div>

{
  more.length > 0 && (
    <ul class="pro-more mt-4 grid gap-4 lg:mt-5 lg:grid-cols-3 lg:gap-5">
      {more.map((item, i) => (
        <li class:list={['pro-more__item reveal', `delay-${i + 1}`]}>
          <h3 class="tile-title">{item.title}</h3>
          <p class="tile-body mt-2">{item.body}</p>
        </li>
      ))}
    </ul>
  )
}
<style is:inline set:html={goalCss + weekCss + calendarCss + accents.map((c, i) => `.ac-${i}{background:${c}}`).join('')}></style>

<style>

  .pro-bento {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .pro-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pro-tile--year {
      grid-column: 1 / -1;
    }

    /* Seven tiles after the year: the calendar takes the last row on its own. */
    .pro-tile--calendar {
      grid-column: 1 / -1;
    }

    /* Four after the year on the home page: two even rows. */
    .pro-bento--compact .pro-tile--calendar {
      grid-column: auto;
    }
  }

  @media (min-width: 1024px) {
    .pro-bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .pro-tile--year {
      grid-column: span 4;
    }

    /* Year and goals, then two rows of three. */
    .pro-tile--goals,
    .pro-tile--reviews,
    .pro-tile--places,
    .pro-tile--focus,
    .pro-tile--style,
    .pro-tile--widget,
    .pro-tile--calendar,
    .pro-bento--compact .pro-tile--calendar {
      grid-column: span 2;
    }
  }

  .pro-tile {
    display: flex;
    flex-direction: column;
  }

  .pro-tile__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 11rem;
    margin: 1rem 1rem 0;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--surface-2);
    overflow: hidden;
  }

  /* From two columns on, every picture is as tall as the others, so the
     titles of a row start on one line. */
  @media (min-width: 640px) {
    .pro-tile__visual {
      height: 15rem;
      min-height: 0;
    }
  }

  .pro-tile__text {
    padding: 1.5rem 1.75rem 1.9rem;
  }

  /* The year: lit from the first week to the last as it comes into view. */
  .pro-year {
    width: 100%;
    height: auto;
    transition: clip-path 1.8s var(--ease-out-soft) 0.2s;
  }

  :global(.js) .reveal:not(.is-visible) .pro-year {
    clip-path: inset(0 100% 0 0);
  }

  :global([dir='rtl']) .reveal:not(.is-visible) .pro-year {
    clip-path: inset(0 0 0 100%);
  }

  .pro-year .lv0 { fill: var(--surface); }
  .pro-year .lv1 { fill: #1f3a8a; }
  .pro-year .lv2 { fill: #3457c8; }
  .pro-year .lv3 { fill: #5f82f0; }
  .pro-year .lv4 { fill: #a8c1ff; }

  .pro-goals {
    width: 8.5rem;
  }

  .pro-goals__track,
  .pro-goals__ring {
    fill: none;
    stroke-width: 11;
    stroke-linecap: round;
  }

  .pro-goals__track {
    opacity: 0.18;
  }

  .pro-goals__ring {
    transition: stroke-dashoffset 1.6s var(--ease-out-expo);
  }

  /* Reviews: a stack of cards, the week on top. */
  .pro-reviews {
    position: relative;
    width: 9.5rem;
    aspect-ratio: 0.78;
  }

  .pro-reviews__card {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }

  .pro-reviews__card--back {
    rotate: -9deg;
    translate: -14% 2%;
    background: linear-gradient(160deg, #ff9500, #ff2d55);
    opacity: 0.85;
  }

  .pro-reviews__card--mid {
    rotate: 6deg;
    translate: 12% 1%;
    background: linear-gradient(160deg, #34c759, #30b0c7);
    opacity: 0.9;
  }

  .pro-reviews__card--front {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    background: linear-gradient(160deg, #3d5fc0, #5856d6);
    color: #fff;
  }

  .pro-reviews__total {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 650;
    font-stretch: 120%;
    font-variant-numeric: tabular-nums;
  }

  .pro-reviews__bars {
    display: flex;
    align-items: flex-end;
    gap: 0.3rem;
    height: 3.5rem;
  }

  .pro-reviews__bar {
    flex: 1;
    border-radius: 0.2rem;
    background: rgb(255 255 255 / 0.92);
    transition: height 1s var(--ease-out-expo);
  }

  .pro-reviews__bar.is-weekend {
    background: rgb(255 255 255 / 0.5);
  }

  :global(.js) .reveal:not(.is-visible) .pro-reviews__bar {
    height: 6%;
  }

  /* Places: a corner of a city map, the zone around the office, and the
     notification the app sends when you arrive there. */
  .places {
    position: absolute;
    inset: 0;
  }

  .places__map {
    width: 100%;
    height: 100%;
    background: #f2efe9;
  }

  :global(.dark) .places__map,
  :global(.night) .places__map {
    background: #20232b;
  }

  .places__blocks rect {
    fill: #e4e0d8;
  }

  :global(.dark) .places__blocks rect,
  :global(.night) .places__blocks rect {
    fill: #2a2e38;
  }

  .places__park {
    fill: #cfe8c3;
  }

  :global(.dark) .places__park,
  :global(.night) .places__park {
    fill: #233a2c;
  }

  .places__water {
    fill: #b9d9f2;
  }

  :global(.dark) .places__water,
  :global(.night) .places__water {
    fill: #1d3346;
  }

  .places__road {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
  }

  :global(.dark) .places__road,
  :global(.night) .places__road {
    stroke: #3a3f4c;
  }

  /* The zone around the office and the task that starts there, below the banner. */
  .places__zone,
  .places__pin {
    position: absolute;
    top: 68%;
    left: 60%;
    translate: -50% -50%;
    border-radius: 50%;
  }

  .places__zone {
    width: 5.6rem;
    height: 5.6rem;
    background: rgb(0 122 255 / 0.16);
    box-shadow: inset 0 0 0 1.5px #0a84ff;
  }

  .places__pin {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    color: #fff;
    box-shadow:
      0 0 0 3px #fff,
      0 4px 10px rgb(0 0 0 / 0.25);
  }

  .places__pin svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* The notification banner, as iOS shows it on arrival. */
  .places__note {
    position: absolute;
    top: 0.75rem;
    inset-inline: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 0.82);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    backdrop-filter: blur(16px) saturate(170%);
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.35);
    color: #0b0b0d;
  }

  :global(.dark) .places__note,
  :global(.night) .places__note {
    background: rgb(44 44 48 / 0.82);
    color: #fff;
  }

  .places__note :global(.places__icon) {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.42rem;
  }

  .places__text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    line-height: 1.25;
  }

  .places__app {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgb(60 60 67 / 0.85);
  }

  :global(.dark) .places__app,
  :global(.night) .places__app {
    color: rgb(235 235 245 / 0.72);
  }

  .places__title {
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .places__body {
    overflow: hidden;
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Focus: Work on, and the task list keeps what belongs to it. */
  .focus {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
  }

  .focus__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem 0.35rem 0.6rem;
    border-radius: 999px;
    background: #5856d6;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .focus__pill svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .focus__list {
    display: flex;
    flex-direction: column;
    width: min(100%, 13rem);
    overflow: hidden;
    border-radius: 0.85rem;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }

  .focus__row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
