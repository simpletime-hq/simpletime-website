---
import type { Block } from '../i18n/day';
import { NOW } from '../i18n/day';

interface Props {
  blocks: Block[];
  /** `hero`: tall, with hours and the moment it is now; `mini`: a thin strip. */
  variant?: 'hero' | 'mini';
  /** Unique per page: the positions below are classes named after it. */
  id: string;
  /** Hour labels under the strip – "0 6 12 18 24". */
  scale?: boolean;
  class?: string;
}

const { blocks, variant = 'hero', id, scale = false, class: className = '' } = Astro.props;

const DAY = 24 * 60;
const pct = (minutes: number) => `${((minutes / DAY) * 100).toFixed(3)}%`;
const showNow = blocks.some((b) => b.running);

// Positions as classes in a style block rather than style attributes: the CSP
// lets hashed <style> elements through, but no inline style attribute. Logical
// properties put the morning on the left – and on the right in Arabic and Hebrew.
// The blocks grow in one after another, as the day did.
const rules = blocks.map(
  (b, i) =>
    `.${id}-${i}{inset-inline-start:${pct(b.start)};width:${pct(b.minutes)};animation-delay:${180 + i * 70}ms}`,
);
if (showNow) rules.push(`.${id}-now{inset-inline-start:${pct(NOW)}}`);
const css = rules.join('');
---

<div class:list={['ribbon', `ribbon--${variant}`, className]} aria-hidden="true">
  <div class="ribbon__track">
    {
      blocks.map((b, i) => (
        <span class:list={['ribbon__block', `bg-${b.task}`, `${id}-${i}`, b.running && 'is-running']} />
      ))
    }
    {showNow && <span class={`ribbon__now ${id}-now`} />}
  </div>
  {
    scale && (
      <div class="ribbon__scale tabular">
        <span class="start-0">0</span>
        <span class="start-1/4">6</span>
        <span class="start-1/2">12</span>
        <span class="start-3/4">18</span>
        <span class="end-0">24</span>
      </div>
    )
  }
</div>
<style is:inline set:html={css}></style>

<style>
  .ribbon {
    position: relative;
    width: 100%;
  }

  .ribbon__track {
    position: relative;
    height: var(--ribbon-h);
    border-radius: calc(var(--ribbon-h) * 0.32);
    /* One faint line per hour. */
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(100% / 24 - 1px),
        var(--ribbon-tick) calc(100% / 24 - 1px),
        var(--ribbon-tick) calc(100% / 24)
      ),
      var(--ribbon-bg);
  }

  .ribbon--hero {
    --ribbon-h: clamp(2.75rem, 1.9rem + 2.2vw, 4.25rem);
    --ribbon-bg: color-mix(in srgb, var(--surface) 62%, transparent);
    --ribbon-tick: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  .ribbon--mini {
    --ribbon-h: 1.375rem;
    --ribbon-bg: color-mix(in srgb, var(--ink) 5%, transparent);
    --ribbon-tick: transparent;
  }

  .ribbon__block {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 3px;
    border-radius: calc(var(--ribbon-h) * 0.22);
    transform-origin: left center;
  }

  :global([dir='rtl']) .ribbon__block {
    transform-origin: right center;
  }

  .ribbon--hero .ribbon__block {
    top: 0.3125rem;
    bottom: 0.3125rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .ribbon--mini .ribbon__block {
    top: 0.25rem;
    bottom: 0.25rem;
  }

  /* The day draws itself in, block by block – only where JS runs the page,
     so a static render shows the finished day. */
  :global(.js) .ribbon--hero .ribbon__block {
    animation: ribbon-grow 1.1s var(--ease-out-expo) both;
  }

  :global(.js) .ribbon--mini .ribbon__block {
    animation: ribbon-grow 1s var(--ease-out-expo) both;
    animation-play-state: paused;
  }

  :global(.js .is-visible) .ribbon--mini .ribbon__block {
    animation-play-state: running;
  }

  @keyframes ribbon-grow {
    from {
      transform: scaleX(0);
      opacity: 0.4;
    }
  }

  /* The running entry breathes at its open end. */
  .ribbon__block.is-running::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 40%;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.45));
    animation: ribbon-breathe 2.4s ease-in-out infinite;
  }

  :global([dir='rtl']) .ribbon__block.is-running::after {
    background: linear-gradient(270deg, transparent, rgb(255 255 255 / 0.45));
  }

  @keyframes ribbon-breathe {
    50% {
      opacity: 0.15;
    }
  }

  /* Now: a hairline through the strip with a dot on top. */
  .ribbon__now {
    position: absolute;
    top: -0.5rem;
    bottom: -0.5rem;
    width: 2px;
    margin-inline-start: -1px;
    border-radius: 2px;
    background: var(--ink);
  }

  .ribbon__now::before {
    content: '';
    position: absolute;
    top: -0.3rem;
    left: 50%;
    width: 0.65rem;
    height: 0.65rem;
    margin-left: -0.325rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .ribbon__now::after {
    content: '';
    position: absolute;
    top: -0.3rem;
    left: 50%;
    width: 0.65rem;
    height: 0.65rem;
    margin-left: -0.325rem;
    border-radius: 50%;
    background: var(--ink);
    animation: ribbon-ping 2.4s var(--ease-out-soft) infinite;
  }

  @keyframes ribbon-ping {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  .ribbon__scale {
    position: relative;
    height: 1.25rem;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--subtle);
  }

  .ribbon__scale span {
    position: absolute;
    top: 0;
    translate: -50% 0;
  }

  :global([dir='rtl']) .ribbon__scale span {
    translate: 50% 0;
  }

  .ribbon__scale span:first-child,
  .ribbon__scale span:last-child {
    translate: none;
  }
</style>
